---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  lang?: string;
  /** Show Safari's Smart App Banner for the English iOS app. English pages only. */
  appBanner?: boolean;
  noindex?: boolean;
}

const { title, description, canonical, lang = 'en', appBanner = lang.startsWith('en'), noindex = false } = Astro.props;
// Cloudflare Web Analytics: cookieless page-view counts. The token is a public beacon token.
const cloudflareBeacon = `<!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "81671c4a884c49d387b2ed2f8950cbcf"}'></script><!-- End Cloudflare Web Analytics -->`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101a2a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {appBanner && <meta name="apple-itunes-app" content="app-id=6773492861" />}
    <link rel="icon" type="image/png" href="/assets/bible-bedtime-logo-20260520.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/assets/og-app-20260918.jpg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.url.pathname === '/' && (
      <link
        rel="preload"
        as="image"
        href="/assets/app/hero-shepherd-dusk.webp"
        media="(min-width: 768px)"
        type="image/webp"
        fetchpriority="high"
      />
    )}
    {Astro.url.pathname === '/' && (
      <link
        rel="preload"
        as="image"
        href="/assets/app/hero-shepherd-dusk-900.webp"
        media="(max-width: 767px)"
        type="image/webp"
        fetchpriority="high"
      />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <slot name="head" />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <slot />
    <Fragment set:html={cloudflareBeacon} />
  </body>
</html>
