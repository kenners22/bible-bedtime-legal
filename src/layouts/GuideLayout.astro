---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AppCta from '../components/AppCta.astro';
import { guides } from '../data/guides';
import { lastModified } from '../lib/lastmod.mjs';
import { SITE, ORGANIZATION_ID } from '../lib/site';

export interface Faq { q: string; a: string }

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  crumb: string;
  campaign: string;
  faqs: Faq[];
  /** First published, YYYY-MM-DD. */
  datePublished?: string;
  ctaHeading?: string;
  ctaText?: string;
  /** Links to jump to a part of the page, shown as pills under the intro. */
  jump?: { label: string; href: string }[];
  /** The page places its own app panel, so the layout leaves its one out. */
  ctaInline?: boolean;
  /** Let a wide part of the page (a table) use the whole width. */
  wide?: boolean;
}

const { title, description, eyebrow, heading, intro, crumb, campaign, faqs, datePublished = '2026-09-18', ctaHeading, ctaText, jump = [], ctaInline = false, wide = false } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const related = guides.filter((g) => g.href !== Astro.url.pathname);
// The page's last change from git, as in the sitemap; the publish date without
// full history, or when the page is newer than its last commit.
const changed = lastModified(Astro.url.pathname);
const dateModified = changed && new Date(changed) > new Date(datePublished) ? changed : datePublished;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: heading,
    description,
    url,
    image: new URL('/assets/og-app-20260918.jpg', Astro.site).href,
    datePublished,
    dateModified,
    author: { '@type': 'Organization', '@id': ORGANIZATION_ID, name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', '@id': ORGANIZATION_ID, name: SITE.name, logo: { '@type': 'ImageObject', url: SITE.logo } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://biblebedtime.uk/' },
      { '@type': 'ListItem', position: 2, name: crumb, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </Fragment>
  <Header />
  <main>
    <section class="band">
      <img src="/assets/app/hero-shepherd-dusk-900.webp" alt="" width="720" height="405" class="band-art band-art-blur" />
      <div aria-hidden="true" class="band-wash"></div>
      <div class="wrap pt-[30px] pb-10 sm:pt-14 sm:pb-16">
        <div class="measure">
          <nav aria-label="Breadcrumb" class="crumbs">
            <a href="/">Home</a>
            <span aria-hidden="true" class="mx-2.5">/</span>
            <span aria-current="page">{crumb}</span>
          </nav>
          <p class="eyebrow mt-4 sm:mt-6">{eyebrow}</p>
          <h1 class="h1-page mt-4">{heading}</h1>
          <p class="lead mt-4 sm:mt-[22px] max-w-[34em]">{intro}</p>
          {jump.length > 0 && (
            <nav aria-label="On this page" class="mt-6 sm:mt-[30px] flex flex-wrap gap-2 sm:gap-2.5">
              {jump.map((j) => <a href={j.href} class="pill-link">{j.label}</a>)}
            </nav>
          )}
        </div>
      </div>
    </section>

    <div class="wrap py-10 sm:py-16">
      <article class:list={['guide', !wide && 'measure']}>
        <slot />

        {!ctaInline && <div class="measure"><AppCta campaign={campaign} heading={ctaHeading} text={ctaText} /></div>}

        <section aria-labelledby="faq-heading" class="measure">
          <h2 id="faq-heading">Questions</h2>
          <div class="mt-5 divide-y divide-cream/[0.12] border-y border-cream/[0.12]">
            {faqs.map((f) => (
              <details class="group py-2">
                <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-5 font-serif font-semibold text-[21px] sm:text-2xl leading-tight text-cream">
                  {f.q}
                  <span aria-hidden="true" class="text-gold-light transition-transform group-open:rotate-45 text-2xl leading-none">+</span>
                </summary>
                <p class="mt-2 mb-3 text-cream/[0.82]">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <section aria-labelledby="related-heading" class="measure">
          <h2 id="related-heading">More for the evening</h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {related.map((g) => (
              <li>
                <a href={g.href} class="panel block h-full px-[22px] py-5 hover:border-gold/50 transition-colors">
                  <span class="h3-page block">{g.title}</span>
                  <span class="mt-1.5 block small text-cream/[0.82]">{g.blurb}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .guide h2 { font-family: 'Cormorant Garamond', 'Cormorant Fallback', Georgia, serif; font-weight: 500; font-size: 32px; line-height: 1.12; margin-top: 2.75rem; color: #F8F3E8; text-wrap: balance; }
  .guide h3 { font-family: 'Cormorant Garamond', 'Cormorant Fallback', Georgia, serif; font-weight: 600; font-size: 24px; line-height: 1.15; margin-top: 2.25rem; color: #F8F3E8; }
  .guide > h2:first-child, .guide > section:first-child > h2:first-child { margin-top: 0; }
  .guide > p, .guide section > p, .guide .prose-p { margin-top: 1.1rem; color: rgba(248, 243, 232, 0.82); }
  .guide h2 + p, .guide h3 + p { margin-top: 1rem; }
  .guide figure { margin-top: 1.5rem; }
  .guide figure + p { margin-top: 1.1rem; }
  .guide ul.bullets { margin-top: 1rem; padding-left: 0; list-style: none; color: rgba(248, 243, 232, 0.82); }
  .guide ul.bullets li { position: relative; padding-left: 24px; }
  .guide ul.bullets li + li { margin-top: 12px; }
  .guide ul.bullets li::before { content: ''; position: absolute; left: 2px; top: 0.72em; width: 7px; height: 7px; border-radius: 999px; background: #D7A84A; }
  .guide ul.bullets strong { color: #F8F3E8; font-weight: 600; }
  .guide a.inline { color: #E4C36F; text-decoration: underline; text-underline-offset: 3px; }
  .guide a.inline:hover { color: #D7A84A; }
  .guide h2[id], .guide section[id] { scroll-margin-top: 84px; }
  @media (min-width: 640px) {
    .guide h2 { font-size: 44px; line-height: 1.1; margin-top: 4rem; }
  }
</style>
