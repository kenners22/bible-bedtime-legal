---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AppCta from '../components/AppCta.astro';
import { guides } from '../data/guides';

export interface Faq { q: string; a: string }

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  crumb: string;
  campaign: string;
  faqs: Faq[];
}

const { title, description, eyebrow, heading, intro, crumb, campaign, faqs } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const related = guides.filter((g) => g.href !== Astro.url.pathname);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: heading,
    description,
    url,
    image: new URL('/assets/og-app-20260918.jpg', Astro.site).href,
    datePublished: '2026-09-18',
    dateModified: '2026-09-18',
    author: { '@type': 'Organization', name: 'Bible Bedtime', url: 'https://biblebedtime.uk/' },
    publisher: { '@type': 'Organization', name: 'Bible Bedtime', logo: { '@type': 'ImageObject', url: 'https://biblebedtime.uk/assets/bible-bedtime-logo-20260520.png' } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://biblebedtime.uk/' },
      { '@type': 'ListItem', position: 2, name: crumb, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </Fragment>
  <Header />
  <main>
    <section class="relative isolate overflow-hidden border-b border-white/[0.08]">
      <img src="/assets/app/hero-shepherd-dusk-900.webp" alt="" width="720" height="405" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-30" />
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-b from-night/70 via-night/85 to-night"></div>
      <div class="max-w-3xl mx-auto px-6 md:px-10 pt-10 pb-14 md:pt-14 md:pb-20">
        <nav aria-label="Breadcrumb" class="text-sm text-cream/60">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span aria-current="page">{crumb}</span>
        </nav>
        <p class="eyebrow mt-8">{eyebrow}</p>
        <h1 class="mt-4 font-medium leading-[1.05] text-[42px] sm:text-[56px]">{heading}</h1>
        <p class="mt-6 text-lg md:text-xl leading-relaxed text-cream/80">{intro}</p>
      </div>
    </section>

    <article class="guide max-w-3xl mx-auto px-6 md:px-10 py-14 md:py-20">
      <slot />

      <AppCta campaign={campaign} />

      <section aria-labelledby="faq-heading" class="mt-16">
        <h2 id="faq-heading">Questions</h2>
        <div class="mt-6 divide-y divide-white/[0.08] border-y border-white/[0.08]">
          {faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-xl text-cream">
                {f.q}
                <span aria-hidden="true" class="text-gold transition-transform group-open:rotate-45 text-2xl leading-none">+</span>
              </summary>
              <p class="mt-3 text-cream/75 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="related-heading" class="mt-16">
        <h2 id="related-heading">More for the evening</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {related.map((g) => (
            <li>
              <a href={g.href} class="panel block p-5 hover:border-gold/40 transition-colors">
                <span class="font-serif text-xl text-cream">{g.title}</span>
                <span class="mt-1 block text-sm text-cream/65">{g.blurb}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .guide h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: clamp(30px, 4.2vw, 40px); line-height: 1.1; margin-top: 3.5rem; color: #f7eddc; }
  .guide h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 26px; line-height: 1.2; margin-top: 2.5rem; color: #f7eddc; }
  .guide > p, .guide section > p, .guide .prose-p { margin-top: 1.1rem; font-size: 1.075rem; line-height: 1.8; color: rgba(247, 237, 220, 0.8); }
  .guide h2 + p, .guide h3 + p { margin-top: 0.9rem; }
  .guide figure { margin-top: 1.4rem; }
  .guide ul.bullets { margin-top: 1.1rem; padding-left: 1.2rem; list-style: disc; color: rgba(247, 237, 220, 0.8); line-height: 1.8; }
  .guide ul.bullets li::marker { color: #d4a14a; }
  .guide a.inline { color: #e2b66a; text-decoration: underline; text-underline-offset: 3px; }
  .guide a.inline:hover { color: #d4a14a; }
</style>
