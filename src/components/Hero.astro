---
---
<section class="relative bg-cream overflow-hidden">
  <div class="max-w-page mx-auto pl-6 md:pl-10 pr-0 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-2 items-center pt-8 pb-0 lg:pt-12">
    <div class="lg:col-span-5 relative z-10 lg:pr-2">
      <h1 class="font-serif font-medium text-navy leading-[1.05] tracking-tight text-[40px] sm:text-[52px] lg:text-[56px] xl:text-[64px]">
        Faith for Today.<br />
        Peace for Tonight.<br />
        Hope for Tomorrow.
      </h1>
      <p class="mt-6 max-w-md text-navy/75 text-lg leading-relaxed">
        Daily scriptures, devotionals, and timeless Bible stories to guide your heart and mind.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/daily-scriptures/" class="btn-gold rounded-md px-6 py-4 text-[15px]">
          Start Free Daily Scriptures
        </a>
        <a href="/bible-stories/" class="btn-outline rounded-md px-6 py-4 text-[15px]">
          Explore Bible Stories
        </a>
      </div>

      <span aria-hidden="true" class="absolute top-2 left-1/2 text-gold/60 text-xl">✦</span>
      <span aria-hidden="true" class="absolute top-32 -left-2 text-gold/40 text-base">✦</span>
      <span aria-hidden="true" class="absolute bottom-10 right-8 text-gold/50 text-lg">✦</span>
    </div>

    <div class="lg:col-span-7 relative pr-6 md:pr-0">
      <div class="hero-photo relative overflow-hidden rounded-[28px] lg:rounded-none lg:rounded-tl-[120px] lg:rounded-bl-[120px]">
        <img
          src="/assets/home-hero-sunrise-20260602.png"
          alt="A woman in a cream knit jumper sitting on a hillside at sunrise, holding a coffee mug with an open Bible in her lap, golden light spilling over distant mountains"
          width="1600"
          height="1067"
          class="block w-full h-auto lg:h-[560px] xl:h-[620px] object-cover"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Soft fade on the left edge of the hero photo on desktop so the
     image melts into the cream rather than starting on a hard line. */
  @media (min-width: 1024px) {
    .hero-photo {
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 100%);
              mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 100%);
    }
  }
</style>
