---
const appStore = 'https://apps.apple.com/gb/app/bible-bedtimes/id6773492861';
---
<section class="relative isolate overflow-hidden">
  <picture>
    <source media="(max-width: 767px)" srcset="/assets/app/hero-shepherd-dusk-900.webp" />
    <img
      src="/assets/app/hero-shepherd-dusk.webp"
      alt=""
      width="1600"
      height="900"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[35%_50%]"
    />
  </picture>
  <!-- Night-navy wash, as on the App Store screenshots: art glows through at the top, settles into the app navy. -->
  <div aria-hidden="true" class="hero-wash absolute inset-0 -z-10"></div>

  <div class="max-w-page mx-auto px-6 md:px-10 pt-14 pb-16 md:pt-20 lg:pt-24 lg:pb-24 grid gap-14 lg:grid-cols-[1.05fr_0.95fr] items-center">
    <div>
      <p class="eyebrow">Bible Bedtimes for iPhone and iPad</p>
      <h1 class="mt-5 font-serif font-medium leading-[1.02] text-[46px] sm:text-[64px] lg:text-[76px] max-w-[640px]">
        A calmer way<br />
        <span class="text-gold-light">to end the day.</span>
      </h1>
      <p class="mt-6 max-w-[540px] text-lg md:text-xl leading-relaxed text-cream/80">
        Peaceful Bible stories, tonight’s Scripture passage and a gentle Daily Teaching, together in one quiet app.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href={appStore} class="btn-gold rounded-full px-7 py-4 text-[17px]">Download on the App Store</a>
        <a href="#inside" class="btn-outline rounded-full px-7 py-4 text-[17px]">See inside the app</a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-cream/70">
        <li class="flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-gold"></span>Free to download</li>
        <li class="flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-gold"></span>Three complete stories free</li>
        <li class="flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-gold"></span>Optional Premium</li>
      </ul>
    </div>

    <div class="hero-phones relative mx-auto w-full max-w-[460px] h-[520px] sm:h-[600px]">
      <img
        src="/assets/app/02-daily-teaching.webp"
        alt="Bible Bedtimes Daily Teaching screen with a King James passage and the day’s teaching"
        width="460"
        height="988"
        fetchpriority="low"
        class="absolute right-0 top-10 w-[62%] rotate-[4deg] opacity-90 drop-shadow-2xl"
      />
      <img
        src="/assets/app/01-tonight.webp"
        alt="Bible Bedtimes Tonight screen with tonight’s Scripture card and a free Genesis video"
        width="460"
        height="988"
        class="absolute left-0 top-0 w-[66%] -rotate-[3deg] drop-shadow-2xl"
      />
    </div>
  </div>
</section>

<style>
  .hero-wash {
    background:
      linear-gradient(90deg, rgba(16, 26, 42, 0.94) 0%, rgba(16, 26, 42, 0.78) 45%, rgba(16, 26, 42, 0.55) 100%),
      linear-gradient(180deg, rgba(16, 26, 42, 0) 55%, #101a2a 100%);
  }
  .hero-phones img {
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.5));
  }
</style>
