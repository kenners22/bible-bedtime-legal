---
---
<section aria-labelledby="verse-heading" class="bg-cream relative overflow-hidden">
  <div class="max-w-page mx-auto px-6 md:px-10 py-20 lg:py-24 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative">
    <img
      src="/assets/leaf-decoration-20260602.png"
      alt=""
      aria-hidden="true"
      width="220"
      height="280"
      class="hidden md:block absolute left-0 bottom-2 w-28 lg:w-36 xl:w-44 select-none pointer-events-none"
      loading="lazy"
    />

    <div class="lg:col-span-8 lg:pl-36 xl:pl-48 relative z-10">
      <h2 id="verse-heading" class="font-serif font-medium text-navy text-xl flex items-center gap-4">
        Verse of the Day
        <span aria-hidden="true" class="h-px w-12 bg-gold/70 inline-block"></span>
      </h2>
      <blockquote class="mt-6 font-serif text-navy text-3xl sm:text-4xl lg:text-[40px] leading-snug">
        &ldquo;Come to me, all you who are weary and burdened, and I will give you rest.&rdquo;
      </blockquote>
      <cite class="not-italic block mt-5 text-navy/70 text-lg font-medium">— Matthew 11:28</cite>
    </div>

    <div class="lg:col-span-4 flex lg:justify-end relative z-10">
      <a
        href="/daily-scriptures/"
        class="btn bg-navy text-cream rounded-lg px-7 py-4 text-base inline-flex items-center gap-3 hover:bg-navy-deep"
      >
        Get Daily Scriptures
        <span aria-hidden="true" class="text-gold">→</span>
      </a>
    </div>
  </div>
</section>
