<section aria-labelledby="verse-heading" class="bg-night">
  <div class="wrap py-[52px] md:py-[88px]">
    <div class="parchment-card mx-auto max-w-3xl px-7 py-10 sm:px-14 sm:py-14 text-center">
      <p class="text-bronze uppercase tracking-[0.16em] text-[13px] font-semibold">Matthew 11:28</p>
      <h2 id="verse-heading" class="mt-3 font-serif font-medium text-parchment-ink text-2xl sm:text-3xl">A verse to rest on</h2>
      <blockquote class="mt-5 font-serif text-parchment-ink text-2xl sm:text-[32px] leading-snug">
        &ldquo;Come unto me, all ye that labour and are heavy laden, and I will give you rest.&rdquo;
      </blockquote>
      <div aria-hidden="true" class="mt-6 flex items-center justify-center gap-3 text-bronze">
        <span class="h-px w-10 bg-bronze/60"></span>✦<span class="h-px w-10 bg-bronze/60"></span>
      </div>
      <a href="/daily-scriptures/" class="mt-7 inline-flex min-h-[48px] items-center gap-2 rounded-full bg-parchment-ink px-6 text-[16px] font-semibold text-parchment hover:bg-night-raised">
        Read a Daily Teaching sample <span aria-hidden="true" class="text-gold-light">→</span>
      </a>
    </div>
  </div>
</section>
