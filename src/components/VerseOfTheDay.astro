<section aria-labelledby="verse-heading" class="bg-night">
  <div class="max-w-page mx-auto px-6 md:px-10 py-16 md:py-24">
    <div class="parchment-card mx-auto max-w-3xl px-7 py-10 sm:px-14 sm:py-14 text-center">
      <p class="text-[#7a4f16] uppercase tracking-[0.22em] text-xs font-semibold">Matthew 11:28</p>
      <h2 id="verse-heading" class="mt-3 font-serif font-medium text-parchment-ink text-2xl sm:text-3xl">A verse to rest on</h2>
      <blockquote class="mt-5 font-serif text-parchment-ink/85 text-2xl sm:text-[32px] leading-snug">
        &ldquo;Come unto me, all ye that labour and are heavy laden, and I will give you rest.&rdquo;
      </blockquote>
      <div aria-hidden="true" class="mt-6 flex items-center justify-center gap-3 text-gold-deep">
        <span class="h-px w-10 bg-gold-deep/60"></span>✦<span class="h-px w-10 bg-gold-deep/60"></span>
      </div>
      <a href="/daily-scriptures/" class="mt-7 inline-flex items-center gap-2 rounded-full bg-parchment-ink px-6 py-3 text-sm font-semibold text-parchment hover:bg-night">
        Read a Daily Teaching sample <span aria-hidden="true" class="text-gold">→</span>
      </a>
    </div>
  </div>
</section>
