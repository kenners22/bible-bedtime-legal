---
import { appStoreLink } from '../lib/appstore';

interface Props {
  campaign: string;
  heading?: string;
  text?: string;
  image?: string;
  imageAlt?: string;
}

const {
  campaign,
  heading = 'Let the app read to you tonight',
  text = 'Bible Bedtimes brings calm Bible stories, tonight’s King James passage and a gentle Daily Teaching together, with a sleep timer. Free to download, with three complete stories free.',
  image = '/assets/app/app-tonight-20261127.webp',
  imageAlt = 'Bible Bedtimes Tonight screen',
} = Astro.props;
---
<aside class="panel app-panel my-12 overflow-hidden grid sm:grid-cols-[1fr_190px] sm:gap-7 items-end">
  <div class="px-[22px] pt-[26px] pb-6 sm:pl-[34px] sm:pr-0 sm:pt-8 sm:pb-[34px]">
    <p class="eyebrow">Bible Bedtimes for iPhone and iPad</p>
    <p class="mt-3 font-serif font-medium text-[32px] leading-[1.12] text-cream">{heading}</p>
    <p class="mt-3 text-cream/[0.82]">{text}</p>
    <a href={appStoreLink(campaign)} class="btn-gold mt-6 w-full sm:w-auto">Download on the App Store</a>
  </div>
  <div class="h-[200px] sm:h-[250px] overflow-hidden flex justify-center">
    <img src={image} alt={imageAlt} width="460" height="976" loading="lazy" decoding="async" class="w-[160px] sm:w-[170px] h-auto self-start" />
  </div>
</aside>
