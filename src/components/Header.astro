---
interface Props {
  locale?: 'en' | 'es';
}

import { appStoreLink } from '../lib/appstore';

const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';
const navLinks = isSpanish
  ? [
      { label: 'Historias bíblicas', href: '/bible-stories/' },
      { label: 'Escrituras diarias', href: '/daily-scriptures/' },
      { label: 'Devocionales', href: '/devotionals/' },
      { label: 'App', href: '/app/' },
      { label: 'Acerca de', href: '/about/' },
    ]
  : [
      { label: 'Bible Stories', href: '/bible-stories/' },
      { label: 'Daily Scriptures', href: '/daily-scriptures/' },
      { label: 'Devotionals', href: '/devotionals/' },
      { label: 'App', href: '/download/' },
      { label: 'About', href: '/about/' },
    ];
const name = isSpanish ? 'Bible Bedtime' : 'Bible Bedtimes';
---
<header class:list={["site-header sticky top-0 z-50 border-b border-cream/[0.12]", isSpanish && "is-es"]}>
  <div class="wrap head-row flex h-[60px] lg:h-16 items-center sm:gap-6 lg:gap-9">
    <a href="/" class="brand mr-auto flex min-h-[44px] min-w-0 items-center sm:gap-3" aria-label={isSpanish ? 'Inicio de Bible Bedtime' : 'Bible Bedtimes home'}>
      <img
        src="/assets/bible-bedtimes-mark-20261127.webp"
        alt=""
        width="40"
        height="40"
        class="brand-mark h-8 w-8 shrink-0 lg:h-10 lg:w-10"
      />
      <span class="brand-name whitespace-nowrap font-serif font-semibold leading-none text-cream">{name}</span>
    </a>

    <nav aria-label={isSpanish ? 'Principal' : 'Primary'} class="hidden lg:flex items-center gap-[30px] text-[16px] font-medium text-cream/[0.82]">
      {navLinks.map((link) => (
        <a href={link.href} class="inline-flex min-h-[44px] items-center hover:text-gold-light transition-colors">{link.label}</a>
      ))}
    </nav>

    <a
      href={isSpanish ? '/daily-scriptures/' : appStoreLink('site_header')}
      class="head-btn btn-gold shrink-0"
    >{isSpanish ? 'Empieza gratis' : 'Get the app'}</a>

    <button
      type="button"
      class="menu-btn lg:hidden grid h-11 w-11 shrink-0 place-items-center rounded-full text-cream hover:text-gold-light"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label={isSpanish ? 'Menú' : 'Menu'}
    >
      <svg class="menu-open-icon h-[26px] w-[26px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      <svg class="menu-close-icon hidden h-[26px] w-[26px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <div id="site-menu" class="site-menu lg:hidden" hidden>
    <nav aria-label={isSpanish ? 'Principal móvil' : 'Primary mobile'} class="wrap pb-5 pt-1.5">
      <ul>
        {navLinks.map((link) => (
          <li class="border-b border-cream/[0.12]">
            <a href={link.href} class="flex h-[52px] items-center justify-between text-[18px] text-cream hover:text-gold-light">
              {link.label}
              <svg class="h-5 w-5 text-cream/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="menu-scrim lg:hidden" hidden></div>
  <noscript>
    <style>
      /* Without JavaScript the menu button can't open the panel, so the five
         links show under the bar instead, as they always did. */
      @media (max-width: 1023px) {
        .site-header .menu-btn { display: none !important; }
        .site-header #site-menu { display: block !important; position: static; }
      }
    </style>
  </noscript>
</header>

<script is:inline>
  (() => {
    const header = document.currentScript.previousElementSibling;
    const button = header.querySelector('.menu-btn');
    const menu = header.querySelector('#site-menu');
    const scrim = header.querySelector('.menu-scrim');
    const setOpen = (open, returnFocus) => {
      button.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      scrim.hidden = !open;
      header.classList.toggle('is-open', open);
      if (open) menu.querySelector('a').focus();
      else if (returnFocus) button.focus();
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true', true));
    scrim.addEventListener('click', () => setOpen(false, true));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    });
    // Close it when focus leaves the header.
    header.addEventListener('focusout', (event) => {
      if (button.getAttribute('aria-expanded') === 'true' && !header.contains(event.relatedTarget) && event.relatedTarget) setOpen(false, false);
    });
    // Close it when the window grows to the wide layout. If the focus was in
    // the menu, move it to the first link in the bar so it isn't lost.
    matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (!event.matches || button.getAttribute('aria-expanded') !== 'true') return;
      const hadFocus = menu.contains(document.activeElement);
      setOpen(false, false);
      if (hadFocus) header.querySelector('nav[aria-label] a').focus();
    });
  })();
</script>

<style>
  .site-header {
    background: rgba(7, 20, 38, 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .brand-name { font-size: 20px; }
  .head-btn { min-height: 44px; padding: 0 16px; font-size: 16px; }
  @media (min-width: 1024px) {
    .brand-name { font-size: 24px; }
    .head-btn { min-height: 48px; padding: 0 22px; }
  }
  .site-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 2;
    background: #071426;
    border-bottom: 1px solid rgba(248, 243, 232, 0.12);
  }
  .menu-scrim {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 100vh;
    z-index: 1;
    background: rgba(0, 0, 0, 0.58);
  }
  .site-menu[hidden], .menu-scrim[hidden] { display: none; }
  .is-open .menu-open-icon { display: none; }
  .is-open .menu-close-icon { display: block; }
  /* Phones: the name, the button and the menu button stay on one row from
     320px up. First the gaps and side padding shrink, then the name, then the
     button's side padding. Nothing is hidden and nothing wraps. */
  @media (max-width: 639px) {
    .head-row { gap: 10px; }
    .brand { gap: 9px; }
    .menu-btn { margin-right: -8px; }
  }
  @media (max-width: 399px) {
    .head-row { gap: 6px; padding-left: 14px; padding-right: 14px; }
    .brand { gap: 7px; }
    .brand-name { font-size: 18px; }
    .head-btn { padding: 0 14px; }
    .menu-btn { margin-right: -6px; }
  }
  @media (max-width: 359px) {
    .head-row { gap: 4px; padding-left: 12px; padding-right: 12px; }
    .brand { gap: 6px; }
    .brand-mark { width: 28px; height: 28px; }
    .brand-name { font-size: 17px; }
    .head-btn { padding: 0 10px; font-size: 15px; }
  }
  /* The Spanish button's words are longer. */
  @media (max-width: 399px) {
    .is-es .head-btn { padding: 0 10px; font-size: 15px; }
  }
  @media (max-width: 359px) {
    .is-es .brand-name { font-size: 16px; }
    .is-es .head-btn { padding: 0 8px; font-size: 14px; }
  }
</style>
