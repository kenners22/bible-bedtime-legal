---
const navLinks = [
  { label: 'Bible Stories', href: '/bible-stories/' },
  { label: 'Daily Scriptures', href: '/daily-scriptures/' },
  { label: 'Devotionals', href: '/devotionals/' },
  { label: "Children's Stories", href: '/childrens-stories/' },
  { label: 'App', href: '/app/' },
  { label: 'About', href: '/about/' },
];
---
<header class="bg-cream">
  <div class="max-w-page mx-auto px-6 md:px-10 py-5 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Bible Bedtime home">
      <img
        src="/assets/bible-bedtime-logo-20260520.png"
        alt=""
        width="52"
        height="52"
        class="w-12 h-12 md:w-14 md:h-14 rounded-xl"
      />
      <span class="font-serif font-semibold text-navy leading-[1.05] text-xl md:text-2xl">
        Bible<br />Bedtime
      </span>
    </a>

    <nav aria-label="Primary" class="hidden lg:flex items-center gap-8 text-[15px] text-navy/85">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-navy transition-colors">{link.label}</a>
      ))}
    </nav>

    <a
      href="/daily-scriptures/"
      class="btn-gold rounded-md px-6 py-3 text-base shrink-0"
    >
      Start Free
    </a>
  </div>

  <nav aria-label="Primary mobile" class="lg:hidden border-t border-navy/10">
    <div class="max-w-page mx-auto px-6 py-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-navy/80">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-navy transition-colors">{link.label}</a>
      ))}
    </div>
  </nav>
</header>
