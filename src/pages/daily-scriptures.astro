---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Daily Scriptures | Bible Bedtime';
const description = 'Read a sample Scripture passage and teaching from Bible Bedtimes. Tonight’s complete passage and Daily Teaching are free in the iPhone and iPad app.';

const steps = [
  {
    title: 'A passage to read',
    description: 'Open the app for tonight’s complete Scripture passage.',
  },
  {
    title: 'Daily Teaching',
    description: 'Read the teaching alongside the passage at your own pace.',
  },
  {
    title: 'Carry it with you',
    description: 'Return to Scripture whenever you need a quiet moment.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="relative bg-night overflow-hidden">
      <div class="max-w-page mx-auto px-6 md:px-10 pt-10 pb-14 lg:pt-16 lg:pb-20 max-w-3xl">
        <p class="eyebrow">Daily Scriptures</p>
        <h1 class="mt-4 font-serif font-medium text-cream leading-[1.05] tracking-tight text-[40px] sm:text-[52px] lg:text-[60px]">
          A Quiet Moment<br />in God’s Word
        </h1>
        <p class="mt-6 text-cream/75 text-lg leading-relaxed">
          Tonight’s complete Scripture passage and Daily Teaching are free in the app.
          Here is a sample of the gentle rhythm you can expect.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/download/" class="btn-gold rounded-full px-6 py-4 text-[15px]">
            Get the App
          </a>
          <a href="/devotionals/" class="btn-outline rounded-full px-6 py-4 text-[15px]">
            See Devotionals
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="sample-heading" class="bg-night-raised/60 border border-white/[0.08] py-14 md:py-20">
      <div class="max-w-page mx-auto px-6 md:px-10 max-w-3xl">
        <p class="eyebrow">A sample from the app</p>
        <h2 id="sample-heading" class="mt-3 font-serif font-medium text-cream text-3xl sm:text-4xl">The Lord Is My Shepherd</h2>
        <blockquote class="mt-7 border-l-4 border-gold pl-5 sm:pl-7 font-serif text-2xl sm:text-3xl leading-snug text-cream">
          “The LORD is my shepherd; I shall not want.”
        </blockquote>
        <p class="mt-3 pl-5 sm:pl-7 text-sm font-semibold text-cream/75">Psalm 23:1 · King James Version</p>
        <h3 class="mt-9 font-serif text-2xl text-cream">From the Daily Teaching</h3>
        <p class="mt-3 text-lg leading-relaxed text-cream/80">Psalm 23 begins with a simple confession of trust. David does not begin with what he lacks, but with who the Lord is.</p>
        <p class="mt-5 text-sm text-cream/70">This is an example, not today’s live passage. Open Bible Bedtimes for tonight’s complete Scripture and teaching.</p>
      </div>
    </section>

    <section aria-labelledby="how-heading" class="bg-night pt-14 pb-20">
      <div class="max-w-page mx-auto px-6 md:px-10">
        <h2 id="how-heading" class="font-serif font-medium text-cream text-center text-3xl sm:text-4xl mb-12">
          How It Works
        </h2>
        <ol class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {steps.map((step, index) => (
            <li class="bg-night-raised/60 border border-white/[0.08] rounded-2xl p-7 flex flex-col gap-3">
              <span class="w-10 h-10 rounded-lg bg-night-deep text-gold-light inline-grid place-items-center font-serif font-semibold">
                {index + 1}
              </span>
              <h3 class="font-serif font-semibold text-cream text-xl">{step.title}</h3>
              <p class="text-cream/70 text-[15px] leading-relaxed">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section aria-label="Verse" class="bg-night-deep text-cream px-6 py-6 text-center">
      <p class="font-serif italic text-base sm:text-lg">
        <span aria-hidden="true" class="text-gold-light mr-2">☾</span>
        &ldquo;This is the day the Lord has made; let us rejoice and be glad in it.&rdquo;
        <span class="text-gold-light font-semibold not-italic ml-2">— Psalm 118:24</span>
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
