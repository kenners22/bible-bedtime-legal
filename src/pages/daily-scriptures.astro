---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import kjv from '../data/kjv.json';
import { appStoreLink } from '../lib/appstore';
const day = kjv['Psalms 118:24'];

const title = 'Daily Scriptures | Bible Bedtimes';
const description = 'Read a sample Scripture passage and teaching from Bible Bedtimes. Tonight’s complete passage and Daily Teaching are free in the iPhone and iPad app.';

const steps = [
  {
    title: 'A passage to read',
    description: 'Open the app for tonight’s complete Scripture passage.',
  },
  {
    title: 'Daily Teaching',
    description: 'Read the teaching alongside the passage at your own pace.',
  },
  {
    title: 'Carry it with you',
    description: 'Return to Scripture whenever you need a quiet moment.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="band">
      <img src="/assets/app/hero-shepherd-dusk-900.webp" alt="" width="720" height="405" class="band-art band-art-blur" />
      <div aria-hidden="true" class="band-wash"></div>
      <div class="wrap pt-[30px] pb-10 sm:pt-14 sm:pb-16"><div class="measure">
        <p class="eyebrow">Daily Scriptures</p>
        <h1 class="h1-page mt-4">
          A quiet moment<br />in God’s Word
        </h1>
        <p class="lead mt-4 sm:mt-[22px]">
          Tonight’s complete Scripture passage and Daily Teaching are free in the app.
          Here is a sample of the gentle rhythm you can expect.
        </p>
        <div class="mt-[26px] sm:mt-8 flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:gap-[14px]">
          <a href={appStoreLink('site_daily_scriptures')} class="btn-gold">
            Download on the App Store
          </a>
          <a href="/devotionals/" class="btn-outline">
            See devotionals
          </a>
        </div>
      </div></div>
    </section>

    <section aria-labelledby="sample-heading" class="bg-night pt-10 sm:pt-16">
      <div class="wrap"><div class="measure panel px-[22px] py-7 sm:px-9 sm:py-9">
        <p class="eyebrow">A sample from the app</p>
        <h2 id="sample-heading" class="mt-3 h2-page">The Lord is my shepherd</h2>
        <blockquote class="mt-7 border-l-2 border-gold pl-5 sm:pl-7 font-serif font-medium text-[22px] sm:text-[28px] leading-snug text-parchment">
          “The LORD is my shepherd; I shall not want.”
        </blockquote>
        <p class="mt-3 pl-5 sm:pl-7 small font-semibold text-gold-light">Psalm 23:1 · King James Version</p>
        <h3 class="mt-9 h3-page">From the Daily Teaching</h3>
        <p class="mt-3 text-cream/[0.82]">Psalm 23 begins with a simple confession of trust. David does not begin with what he lacks, but with who the Lord is.</p>
        <p class="mt-5 small text-cream/70">This is an example, not today’s live passage. Open Bible Bedtimes for tonight’s complete Scripture and teaching.</p>
      </div></div>
    </section>

    <section aria-labelledby="how-heading" class="bg-night pt-12 sm:pt-16 pb-[52px] sm:pb-[88px]">
      <div class="wrap">
        <h2 id="how-heading" class="h2-page mb-8 sm:mb-10">
          How it works
        </h2>
        <ol class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {steps.map((step, index) => (
            <li class="panel p-7 flex flex-col gap-3">
              <span class="w-10 h-10 rounded-full border border-gold/60 text-gold-light inline-grid place-items-center font-serif font-semibold">
                {index + 1}
              </span>
              <h3 class="h3-page">{step.title}</h3>
              <p class="text-cream/[0.82]">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section aria-label="Verse" class="bg-night-deep text-cream border-t border-cream/[0.12]">
      <div class="wrap py-6 text-center">
      <p class="font-serif italic text-[20px] sm:text-[22px] leading-snug">
        <span aria-hidden="true" class="text-gold-light mr-2">☾</span>
        &ldquo;{day.text}&rdquo;
        <span class="text-gold-light font-semibold not-italic ml-2">— {day.reference} (KJV)</span>
      </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
