---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Daily Scriptures | Bible Bedtime';
const description = 'Start each day with an uplifting Bible verse and a short reflection from Bible Bedtime — gentle encouragement delivered through the app, free.';

const steps = [
  {
    title: 'A verse each morning',
    description: 'Wake to a hand-picked scripture chosen to encourage, steady and inspire.',
  },
  {
    title: 'A short reflection',
    description: 'A few thoughtful lines help the verse settle into your day.',
  },
  {
    title: 'Carry it with you',
    description: 'Save your favourites and revisit them whenever you need a quiet moment.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="relative bg-cream overflow-hidden">
      <div class="max-w-page mx-auto px-6 md:px-10 pt-10 pb-14 lg:pt-16 lg:pb-20 max-w-3xl">
        <p class="text-navy/70 font-semibold tracking-wide uppercase text-sm">Daily Scriptures</p>
        <h1 class="mt-4 font-serif font-medium text-navy leading-[1.05] tracking-tight text-[40px] sm:text-[52px] lg:text-[60px]">
          A Verse to Begin<br />Every Day
        </h1>
        <p class="mt-6 text-navy/75 text-lg leading-relaxed">
          Uplifting scripture and a short reflection, ready each morning. A small, steady
          rhythm of faith that brings peace to your day — free to start.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/app/" class="btn bg-navy text-cream rounded-md px-6 py-4 text-[15px] hover:bg-navy-deep">
            Start Free
          </a>
          <a href="/devotionals/" class="btn-outline rounded-md px-6 py-4 text-[15px]">
            See Devotionals
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="how-heading" class="bg-cream pb-20">
      <div class="max-w-page mx-auto px-6 md:px-10">
        <h2 id="how-heading" class="font-serif font-medium text-navy text-center text-3xl sm:text-4xl mb-12">
          How It Works
        </h2>
        <ol class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {steps.map((step, index) => (
            <li class="bg-cream-300/60 rounded-2xl p-7 flex flex-col gap-3">
              <span class="w-10 h-10 rounded-lg bg-navy text-gold inline-grid place-items-center font-serif font-semibold">
                {index + 1}
              </span>
              <h3 class="font-serif font-semibold text-navy text-xl">{step.title}</h3>
              <p class="text-navy/70 text-[15px] leading-relaxed">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section aria-label="Verse" class="bg-navy text-cream py-6 text-center">
      <p class="font-serif italic text-base sm:text-lg">
        <span aria-hidden="true" class="text-gold mr-2">☾</span>
        &ldquo;This is the day the Lord has made; let us rejoice and be glad in it.&rdquo;
        <span class="text-gold font-semibold not-italic ml-2">— Psalm 118:24</span>
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
