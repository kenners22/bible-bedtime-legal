---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Devotionals | Bible Bedtime';
const description = 'Short, practical devotionals from Bible Bedtime to help you grow in faith — Scripture, reflection and prayer for a few quiet minutes each day.';

const parts = [
  {
    title: 'Scripture',
    description: 'A passage to read slowly and let speak for itself.',
  },
  {
    title: 'Reflection',
    description: 'A grounded thought that connects the verse to everyday life.',
  },
  {
    title: 'Prayer',
    description: 'A few honest words to carry the moment into the rest of your day.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="relative bg-cream overflow-hidden">
      <div class="max-w-page mx-auto px-6 md:px-10 pt-10 pb-14 lg:pt-16 lg:pb-20 max-w-3xl">
        <p class="text-navy/70 font-semibold tracking-wide uppercase text-sm">Devotionals</p>
        <h1 class="mt-4 font-serif font-medium text-navy leading-[1.05] tracking-tight text-[40px] sm:text-[52px] lg:text-[60px]">
          A Few Quiet Minutes<br />to Grow in Faith
        </h1>
        <p class="mt-6 text-navy/75 text-lg leading-relaxed">
          Practical, unhurried readings that meet you where you are. Each devotional pairs
          a passage of Scripture with a short reflection and a simple prayer — enough to
          steady the heart without crowding the day.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/app/" class="btn bg-navy text-cream rounded-md px-6 py-4 text-[15px] hover:bg-navy-deep">
            Start Free
          </a>
          <a href="/daily-scriptures/" class="btn-outline rounded-md px-6 py-4 text-[15px]">
            Daily Scriptures
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="inside-heading" class="bg-cream pb-20">
      <div class="max-w-page mx-auto px-6 md:px-10">
        <h2 id="inside-heading" class="font-serif font-medium text-navy text-center text-3xl sm:text-4xl mb-12">
          What’s Inside Each One
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {parts.map((part) => (
            <li class="bg-cream-300/60 rounded-2xl p-7 flex flex-col gap-3">
              <h3 class="font-serif font-semibold text-navy text-xl">{part.title}</h3>
              <p class="text-navy/70 text-[15px] leading-relaxed">{part.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-label="Verse" class="bg-navy text-cream py-6 text-center">
      <p class="font-serif italic text-base sm:text-lg">
        <span aria-hidden="true" class="text-gold mr-2">☾</span>
        &ldquo;Be still, and know that I am God.&rdquo;
        <span class="text-gold font-semibold not-italic ml-2">— Psalm 46:10</span>
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
