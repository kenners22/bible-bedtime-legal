---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Devotionals | Bible Bedtime';
const description = 'Read a complete Scripture passage and Daily Teaching free in Bible Bedtimes. Premium adds access to the teaching archive, prayers and closing blessings.';

const parts = [
  {
    title: 'Scripture',
    description: 'A passage to read slowly and let speak for itself.',
  },
  {
    title: 'Reflection',
    description: 'A grounded thought that connects the verse to everyday life.',
  },
  {
    title: 'Prayer with Premium',
    description: 'Premium gives you prayers, closing blessings and the teaching archive.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="relative bg-night overflow-hidden">
      <div class="max-w-page mx-auto px-6 md:px-10 pt-10 pb-14 lg:pt-16 lg:pb-20 max-w-3xl">
        <p class="eyebrow">Devotionals</p>
        <h1 class="mt-4 font-serif font-medium text-cream leading-[1.05] tracking-tight text-[40px] sm:text-[52px] lg:text-[60px]">
          A Few Quiet Minutes<br />to Grow in Faith
        </h1>
        <p class="mt-6 text-cream/75 text-lg leading-relaxed">
          Practical, unhurried readings that meet you where you are. Tonight’s Scripture
          passage and Daily Teaching are free; Premium adds prayers, closing blessings
          and a teaching archive when you want to go further.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/daily-scriptures/" class="btn-gold rounded-full px-6 py-4 text-[15px]">
            Read Sample Scripture
          </a>
          <a href="/download/" class="btn-outline rounded-full px-6 py-4 text-[15px]">
            Get the App
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="inside-heading" class="bg-night pb-20">
      <div class="max-w-page mx-auto px-6 md:px-10">
        <h2 id="inside-heading" class="font-serif font-medium text-cream text-center text-3xl sm:text-4xl mb-12">
          What’s Inside Each One
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {parts.map((part) => (
            <li class="bg-night-raised/60 border border-white/[0.08] rounded-2xl p-7 flex flex-col gap-3">
              <h3 class="font-serif font-semibold text-cream text-xl">{part.title}</h3>
              <p class="text-cream/70 text-[15px] leading-relaxed">{part.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-label="Verse" class="bg-night-deep text-cream py-6 text-center">
      <p class="font-serif italic text-base sm:text-lg">
        <span aria-hidden="true" class="text-gold-light mr-2">☾</span>
        &ldquo;Be still, and know that I am God.&rdquo;
        <span class="text-gold-light font-semibold not-italic ml-2">— Psalm 46:10</span>
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
