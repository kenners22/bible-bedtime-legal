---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { appStoreLink } from '../lib/appstore';

const title = 'Devotionals | Bible Bedtimes';
const description = 'Read a complete Scripture passage and Daily Teaching free in Bible Bedtimes. Premium adds access to the teaching archive, prayers and closing blessings.';

const parts = [
  {
    title: 'Scripture',
    description: 'A passage to read slowly and let speak for itself.',
  },
  {
    title: 'Reflection',
    description: 'A grounded thought that connects the verse to everyday life.',
  },
  {
    title: 'Prayer with Premium',
    description: 'Premium gives you prayers, closing blessings and the teaching archive.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="band">
      <img src="/assets/app/hero-shepherd-dusk-900.webp" alt="" width="720" height="405" class="band-art band-art-blur" />
      <div aria-hidden="true" class="band-wash"></div>
      <div class="wrap pt-[30px] pb-10 sm:pt-14 sm:pb-16"><div class="measure">
        <p class="eyebrow">Devotionals</p>
        <h1 class="h1-page mt-4">
          A few quiet minutes<br />to grow in faith
        </h1>
        <p class="lead mt-4 sm:mt-[22px]">
          Practical, unhurried readings that meet you where you are. Tonight’s Scripture
          passage and Daily Teaching are free; Premium adds prayers, closing blessings
          and a teaching archive when you want to go further.
        </p>
        <div class="mt-[26px] sm:mt-8 flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:gap-[14px]">
          <a href="/daily-scriptures/" class="btn-gold">
            Read sample Scripture
          </a>
          <a href={appStoreLink('site_devotionals')} class="btn-outline">
            Download on the App Store
          </a>
        </div>
      </div></div>
    </section>

    <section aria-labelledby="inside-heading" class="bg-night pt-10 sm:pt-16 pb-[52px] sm:pb-[88px]">
      <div class="wrap">
        <h2 id="inside-heading" class="h2-page mb-8 sm:mb-10">
          What’s inside each one
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {parts.map((part) => (
            <li class="panel p-7 flex flex-col gap-3">
              <h3 class="h3-page">{part.title}</h3>
              <p class="text-cream/[0.82]">{part.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-label="Verse" class="bg-night-deep text-cream border-t border-cream/[0.12]">
      <div class="wrap py-6 text-center">
      <p class="font-serif italic text-[20px] sm:text-[22px] leading-snug">
        <span aria-hidden="true" class="text-gold-light mr-2">☾</span>
        &ldquo;Be still, and know that I am God.&rdquo;
        <span class="text-gold-light font-semibold not-italic ml-2">— Psalm 46:10</span>
      </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
