---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'About | Bible Bedtime';
const description = 'Bible Bedtime brings daily Scripture, thoughtful teaching and peaceful Bible stories into the rhythm of everyday life.';

const values = [
  {
    title: 'Gentle by design',
    description: 'Calm words, warm tone, and a quiet pace — made for the end of the day.',
  },
  {
    title: 'Faithful to Scripture',
    description: 'Stories and reflections that stay true to the heart of the Bible.',
  },
  {
    title: 'Room to reflect',
    description: 'Scripture and storytelling at a gentle pace, whenever you need a quiet moment.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="relative bg-night overflow-hidden">
      <div class="max-w-page mx-auto px-6 md:px-10 pt-10 pb-14 lg:pt-16 lg:pb-20 max-w-3xl">
        <p class="eyebrow">About</p>
        <h1 class="mt-4 font-serif font-medium text-cream leading-[1.05] tracking-tight text-[40px] sm:text-[52px] lg:text-[60px]">
          Faith for Today.<br />Peace for Tonight.
        </h1>
        <p class="mt-6 text-cream/75 text-lg leading-relaxed">
          Bible Bedtime began with a simple wish: to make space for God’s Word in the
          everyday — a verse with your morning coffee, a devotional in a spare moment, a
          gentle story at the close of the day.
        </p>
        <p class="mt-4 text-cream/75 text-lg leading-relaxed">
          We bring daily Scripture, thoughtful teaching and timeless Bible stories
          together in one calm place, with room to listen, read and reflect.
        </p>
      </div>
    </section>

    <section aria-labelledby="values-heading" class="bg-night pb-20">
      <div class="max-w-page mx-auto px-6 md:px-10">
        <h2 id="values-heading" class="font-serif font-medium text-cream text-center text-3xl sm:text-4xl mb-12">
          What We Believe
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {values.map((value) => (
            <li class="bg-night-raised/60 border border-white/[0.08] rounded-2xl p-7 flex flex-col gap-3">
              <h3 class="font-serif font-semibold text-cream text-xl">{value.title}</h3>
              <p class="text-cream/70 text-[15px] leading-relaxed">{value.description}</p>
            </li>
          ))}
        </ul>
        <div class="mt-12 text-center">
          <a href="/download/" class="btn-gold rounded-full px-7 py-4 text-[15px]">
            Get the App
          </a>
        </div>
      </div>
    </section>

    <section aria-label="Verse" class="bg-night-deep text-cream py-6 text-center">
      <p class="font-serif italic text-base sm:text-lg">
        <span aria-hidden="true" class="text-gold-light mr-2">☾</span>
        &ldquo;Come to me, all you who are weary and burdened, and I will give you rest.&rdquo;
        <span class="text-gold-light font-semibold not-italic ml-2">— Matthew 11:28</span>
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
