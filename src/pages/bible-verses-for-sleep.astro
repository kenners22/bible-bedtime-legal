---
import GuideLayout from '../layouts/GuideLayout.astro';
import Verse from '../components/Verse.astro';
import type kjv from '../data/kjv.json';

type Ref = keyof typeof kjv;
interface Group { id: string; question: string; lead: string; verses: { ref: Ref; note?: string }[] }

// Grouped by the kind of night someone is having. Every verse is printed
// from kjv.json, so the count in the title is always the count on the page.
const groups: Group[] = [
  {
    id: 'about-sleep',
    question: 'What does the Bible say about sleep?',
    lead: 'Start here on an ordinary evening. Each of these links sleep to trust rather than to getting everything done.',
    verses: [
      { ref: 'Psalms 4:8', note: 'David wrote this after a day of pressure and criticism. The peace comes before the sleep, and the safety comes from God alone.' },
      { ref: 'Proverbs 3:24' },
      { ref: 'Psalms 127:2', note: 'A gentle correction for anyone who works late to stay ahead: sleep is described as a gift to the people God loves.' },
      { ref: 'Psalms 3:5' },
      { ref: 'Exodus 33:14', note: 'Spoken to Moses in the wilderness, when the road ahead was long. The promise is presence first, and rest with it.' },
      { ref: 'Psalms 116:7', note: 'A verse to say to yourself as you lie down: the soul is told to go back to its rest, remembering what God has already done.' },
    ],
  },
  {
    id: 'anxiety',
    question: 'Which Bible verses help with anxiety at night?',
    lead: 'When thoughts keep circling, these verses give the worry somewhere to go.',
    verses: [
      { ref: 'Philippians 4:6-7', note: '“Be careful for nothing” means “do not be anxious about anything”. Paul’s answer is not to ignore the worry but to pray it, with thanks, and let God’s peace stand guard.' },
      { ref: '1 Peter 5:7' },
      { ref: 'Matthew 6:34', note: 'Tomorrow’s problems belong to tomorrow. Jesus gives permission to stop solving them tonight.' },
      { ref: 'Psalms 94:19', note: 'An honest picture of a busy mind, “the multitude of my thoughts”, met by comfort rather than by a demand to stop thinking.' },
      { ref: 'Isaiah 26:3' },
      { ref: 'John 14:27' },
      { ref: 'Matthew 11:28-30', note: 'Jesus’ invitation is to the tired and the overloaded, and what he offers is rest for the soul, not just the body.' },
    ],
  },
  {
    id: 'fear',
    question: 'What can I read when I am afraid at night?',
    lead: 'For darkness, a quiet house, or fear you cannot quite name. These verses are about being kept.',
    verses: [
      { ref: 'Psalms 56:3', note: 'One short line, easy to remember in the dark.' },
      { ref: 'Psalms 34:4' },
      { ref: 'Isaiah 41:10', note: 'Three promises in one verse: I will strengthen, I will help, I will uphold.' },
      { ref: 'Psalms 91:1-2' },
      { ref: 'Psalms 121:3-4', note: 'The one who keeps you does not sleep, so you can. That is what makes Psalm 121 such a natural bedtime psalm.' },
      { ref: 'Deuteronomy 33:12' },
      { ref: 'Psalms 32:7' },
      { ref: 'Psalms 18:28', note: 'Written for real darkness: the LORD lights the candle.' },
    ],
  },
  {
    id: 'cannot-sleep',
    question: 'What should I read when I cannot sleep?',
    lead: 'If you are awake at 3am, these verses change the question from “why can’t I sleep?” to “who is with me now?”',
    verses: [
      { ref: 'Psalms 63:6-7', note: 'David lies awake and remembers God “in the night watches”. Wakefulness becomes a time for quiet prayer rather than frustration.' },
      { ref: 'Psalms 16:7-8' },
      { ref: 'Psalms 42:8' },
      { ref: 'Psalms 46:10' },
    ],
  },
  {
    id: 'hard-day',
    question: 'Which verses help after a hard or sad day?',
    lead: 'For evenings when you are worn out, grieving or disappointed in yourself.',
    verses: [
      { ref: 'Psalms 30:5', note: 'The night is not denied, and neither is the weeping. But the night is not the end of the sentence.' },
      { ref: 'Psalms 103:13-14', note: 'God “remembereth that we are dust”: he knows your limits better than you do, and is kind about them.' },
      { ref: 'Isaiah 43:2' },
      { ref: 'Isaiah 40:31' },
      { ref: '2 Thessalonians 3:16' },
    ],
  },
  {
    id: 'children',
    question: 'Is there a Bible blessing to say over children at bedtime?',
    lead: 'The priestly blessing from Numbers is one of the oldest blessings in Scripture, and it is short and gentle enough to say quietly over a sleeping child.',
    verses: [{ ref: 'Numbers 6:24-26' }],
  },
  {
    id: 'morning',
    question: 'And one for the morning',
    lead: 'To read when you wake, whatever kind of night it was.',
    verses: [{ ref: 'Lamentations 3:22-23' }],
  },
];

const count = groups.reduce((n, g) => n + g.verses.length, 0);

const faqs = [
  {
    q: 'What is the best Bible verse for sleep?',
    a: 'Psalm 4:8 is the verse most people turn to: “I will both lay me down in peace, and sleep: for thou, LORD, only makest me dwell in safety.” David wrote it at the end of a hard day, and it ties sleep to trust in God rather than to circumstances.',
  },
  {
    q: 'Which Bible verse is good for anxiety at night?',
    a: 'Philippians 4:6–7 is the most practical: it turns worry into prayer, with thanks, and promises a peace that keeps the heart and mind. 1 Peter 5:7, Matthew 6:34 and John 14:27 also speak directly to a mind that will not settle at the end of the day.',
  },
  {
    q: 'What Bible verse can I read when I can’t sleep?',
    a: 'Psalm 63:6–7 describes lying awake and remembering God “in the night watches”. It treats wakefulness as a time for quiet prayer rather than frustration. Psalm 42:8, which speaks of God’s song being with us in the night, is another good verse for the small hours.',
  },
  {
    q: 'Why are these verses in the King James Version?',
    a: 'The King James Version is the translation used for the Daily Scripture passages in the Bible Bedtimes app, and its rhythm suits reading aloud slowly at night. Every verse on this page is printed in that version with its chapter and verse, so you can find it again in your own Bible.',
  },
];
---
<GuideLayout
  title={`Bible Verses for Sleep: ${count} KJV Verses for Peace and Rest`}
  description="Bible verses for sleep in the King James Version, grouped by need: peace at bedtime, anxiety at night, fear of the dark, sleepless nights and hard days."
  eyebrow="Scripture for bedtime"
  heading={`${count} Bible verses for sleep`}
  intro="King James verses to read slowly at the end of the day: for lying down in peace, for a mind that will not settle, for fear in the dark, for the hours when sleep will not come, and for the morning after."
  crumb="Bible verses for sleep"
  campaign="site_guide_verses_sleep"
  faqs={faqs}
>
  <p>Scripture does not promise that every night will be easy. It does keep returning to one idea: rest is something God gives, not something we earn by getting everything finished. These verses are grouped by the kind of night you are having, so you can go straight to the one you need.</p>

  <nav aria-label="Jump to a section" class="panel mt-8 px-6 py-5">
    <p class="font-semibold text-cream">Jump to</p>
    <ul class="bullets !mt-2">
      {groups.map((g) => <li><a class="inline" href={`#${g.id}`}>{g.question}</a> <span class="text-cream/55">({g.verses.length})</span></li>)}
    </ul>
  </nav>

  {groups.map((g) => (
    <section id={g.id} class="scroll-mt-24">
      <h2>{g.question}</h2>
      <p>{g.lead}</p>
      {g.verses.map((v) => (
        <>
          <Verse ref={v.ref} />
          {v.note && <p>{v.note}</p>}
        </>
      ))}
    </section>
  ))}

  <h2>How do I use Bible verses at bedtime?</h2>
  <ul class="bullets">
    <li><strong>Choose one verse, not ten.</strong> A single verse read slowly two or three times settles the mind better than a long list.</li>
    <li><strong>Read it aloud, quietly.</strong> Hearing the words keeps your attention from drifting back to the day.</li>
    <li><strong>Pray it back.</strong> Turn the verse into a sentence to God, for example: “Lord, I will lie down in peace, because you keep me safe.”</li>
    <li><strong>Keep it by the bed.</strong> If you wake in the night, you will not have to reach for a bright screen to find it.</li>
    <li><strong>Let someone else read.</strong> Listening to Scripture read calmly, as in the <a class="inline" href="/bible-sleep-stories/">Bible sleep stories</a> in our app, lets you close your eyes while the words carry on.</li>
  </ul>
  <p>If you would like a longer passage, the <a class="inline" href="/psalms-for-sleep/">psalms for sleep</a> are a natural next step, and our <a class="inline" href="/bedtime-prayers-for-adults/">bedtime prayers for adults</a> are written to follow them. For stories built on some of these passages, see <a class="inline" href="/stories/psalm-91-under-the-shadow/">Psalm 91 — Under the Shadow</a> and <a class="inline" href="/stories/elijah-still-small-voice/">Elijah and the Still Small Voice</a>.</p>
</GuideLayout>
