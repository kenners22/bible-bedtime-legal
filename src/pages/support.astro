---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Support | Bible Bedtimes';
const description = 'Support for the Bible Bedtimes app: subscriptions and restore purchases, stories or Daily Scripture not loading, audio playback, and how to get in touch.';
---
<BaseLayout title={title} description={description}>
  <Header />
  <main class="bg-night">
    <div class="wrap py-10 sm:py-16"><article class="measure">
      <h1 class="h1-page">Support</h1>
      <p class="small text-cream/70 mt-3">Last updated: June 12, 2026</p>

      <p class="lead mt-6">Bible Bedtimes is built for calm Bible story listening and daily scripture reflection. If something is not working as expected, the checks below resolve the most common issues.</p>

      <h2 class="h3-page mt-10">Premium or subscription issues</h2>
      <p class="mt-3 text-cream/[0.82]">Open the Premium screen and tap Restore Purchases. Make sure you are signed in with the same Apple ID used for the subscription. Subscriptions can be managed or cancelled at any time in your Apple account settings.</p>

      <h2 class="h3-page mt-10">Stories or Daily Scripture not loading</h2>
      <p class="mt-3 text-cream/[0.82]">Check your internet connection, then close and reopen the app. Bible Bedtimes keeps the last successful content feed where possible, so previously loaded content should remain available even if the network is temporarily unavailable.</p>

      <h2 class="h3-page mt-10">Audio not playing</h2>
      <p class="mt-3 text-cream/[0.82]">Check your device volume, silent mode, Bluetooth output, and network connection. If the issue continues, restart the app and try a free story such as Genesis first.</p>

      <h2 class="h3-page mt-10">Privacy and terms</h2>
      <p class="mt-3 text-cream/[0.82]">Read the <a class="inline" href="/privacy/">Privacy Policy</a> and <a class="inline" href="/terms/">Terms of Service</a>.</p>

      <h2 class="h3-page mt-10">Contact</h2>
      <p class="mt-3 text-cream/[0.82]">For support, contact Bible Bedtimes through the official social profile: <a class="inline" href="https://www.tiktok.com/@biblebedtimestories22">@biblebedtimestories22 on TikTok</a>.</p>
    </article></div>
  </main>
  <Footer />
</BaseLayout>
