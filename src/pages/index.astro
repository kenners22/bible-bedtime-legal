---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeatureBand from '../components/FeatureBand.astro';
import VerseOfTheDay from '../components/VerseOfTheDay.astro';
import Footer from '../components/Footer.astro';

const title = 'Bible Bedtime — Faith for Today. Peace for Tonight. Hope for Tomorrow.';
const description = 'Bible Bedtime brings peaceful Bible stories, daily Scripture and teaching together in the Bible Bedtimes app for quiet reflection.';
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <FeatureBand />
    <VerseOfTheDay />
  </main>
  <Footer />
</BaseLayout>
