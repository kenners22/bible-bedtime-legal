---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Page not found | Bible Bedtimes"
  description="This page isn’t here. The address may be old or mistyped. Go to the Bible Bedtimes home page or see all the stories."
  noindex
>
  <Header />
  <main>
    <section class="band min-h-[60vh]">
      <img src="/assets/app/hero-shepherd-dusk-900.webp" alt="" width="720" height="405" class="band-art band-art-blur" />
      <div aria-hidden="true" class="band-wash"></div>
      <div class="wrap pt-12 pb-16 sm:pt-20 sm:pb-24">
        <div class="measure">
          <p class="eyebrow">Page not found</p>
          <h1 class="h1-page mt-4">This page isn’t here.</h1>
          <p class="lead mt-4 sm:mt-[22px]">The address may be old or mistyped.</p>
          <div class="mt-[26px] sm:mt-8 flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:gap-[14px]">
            <a href="/" class="btn-gold">Go to the home page</a>
            <a href="/stories/" class="btn-outline">All stories</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
