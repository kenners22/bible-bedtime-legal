---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Children's Bedtime Stories by Email | Bible Bedtime";
const description = "Personalised Bible bedtime stories for your children, ready each evening through the Bible Bedtime app — gentle, faith-filled tales that make bedtime peaceful.";

const benefits = [
  {
    title: 'Personalised for your child',
    description: 'Stories that use your child’s name and speak to their age.',
  },
  {
    title: 'Rooted in Scripture',
    description: 'Gentle retellings that carry the heart of the Bible into bedtime.',
  },
  {
    title: 'Calm by bedtime',
    description: 'A soothing close to the day that helps little ones settle and sleep.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="relative bg-cream overflow-hidden">
      <div class="max-w-page mx-auto px-6 md:px-10 pt-10 pb-14 lg:pt-16 lg:pb-20 max-w-3xl">
        <p class="text-navy/70 font-semibold tracking-wide uppercase text-sm">Children’s Stories</p>
        <h1 class="mt-4 font-serif font-medium text-navy leading-[1.05] tracking-tight text-[40px] sm:text-[52px] lg:text-[60px]">
          A New Bedtime Story,<br />Made for Your Child
        </h1>
        <p class="mt-6 text-navy/75 text-lg leading-relaxed">
          Personalised Bible stories that bring your child into the story by name — warm,
          gentle and faith-filled, ready each evening to make bedtime peaceful and
          meaningful. Free to start.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/app/" class="btn bg-navy text-cream rounded-md px-6 py-4 text-[15px] hover:bg-navy-deep">
            Start Free
          </a>
          <a href="/childrens-stories/" class="btn-outline rounded-md px-6 py-4 text-[15px]">
            Learn More
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="benefits-heading" class="bg-cream pb-20">
      <div class="max-w-page mx-auto px-6 md:px-10">
        <h2 id="benefits-heading" class="font-serif font-medium text-navy text-center text-3xl sm:text-4xl mb-12">
          Why Families Love It
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {benefits.map((benefit) => (
            <li class="bg-cream-300/60 rounded-2xl p-7 flex flex-col gap-3">
              <h3 class="font-serif font-semibold text-navy text-xl">{benefit.title}</h3>
              <p class="text-navy/70 text-[15px] leading-relaxed">{benefit.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-label="Verse" class="bg-navy text-cream py-6 text-center">
      <p class="font-serif italic text-base sm:text-lg">
        <span aria-hidden="true" class="text-gold mr-2">☾</span>
        &ldquo;Let the little children come to me.&rdquo;
        <span class="text-gold font-semibold not-italic ml-2">— Matthew 19:14</span>
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
