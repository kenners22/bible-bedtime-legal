---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { appStoreLink } from '../lib/appstore';
const appStore = appStoreLink('site_download_top');
const appStoreBottom = appStoreLink('site_download_bottom');
// Apple's current 0.1.14 App Store screenshot. The fresh simulator capture is
// retained separately as QA evidence; no app UI is redrawn for this page.
const tonightScreenshot = 'https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/cf/83/7f/cf837f1f-2b93-6360-8747-c36ab9e5676e/01-tonight.png/600x1200bb.jpg';
---
<BaseLayout
  title="Bible Bedtimes app — peaceful Bible stories for iPhone and iPad"
  description="Listen to three complete Bible stories free and read tonight’s Scripture and Daily Teaching in the Bible Bedtimes app for iPhone and iPad."
>
  <Header />
  <main>
    <section class="bg-night">
      <div class="max-w-page mx-auto px-6 md:px-10 py-12 md:py-20 grid gap-12 lg:grid-cols-[1.1fr_0.9fr] items-center">
        <div>
          <p class="eyebrow">Bible Bedtimes for iPhone and iPad</p>
          <h1 class="mt-4 max-w-[700px] text-[44px] sm:text-[60px] lg:text-[72px] leading-[1.02] font-medium">A quieter way to end the day.</h1>
          <p class="mt-6 max-w-[610px] text-lg md:text-xl leading-relaxed text-cream/80">Peaceful Bible stories, tonight’s Scripture passage and a thoughtful daily teaching—all together in the app.</p>
          <div class="mt-8 flex flex-wrap gap-4 items-center">
            <a class="btn-gold rounded-lg px-7 py-4 text-lg" href={appStore}>Download on the App Store</a>
            <a class="btn-outline rounded-full px-7 py-4 text-lg" href="/bible-stories/">Explore the stories</a>
          </div>
          <p class="mt-4 text-sm text-cream/70">Free to download. Three complete stories and tonight’s passage and teaching are free. Optional Premium subscription for more.</p>
        </div>
        <div class="mx-auto w-full max-w-[400px] rounded-[38px] bg-night-deep p-3 shadow-2xl">
          <img
            src={tonightScreenshot}
            alt="App Store preview of the Bible Bedtimes Tonight screen, with a daily Scripture card and a free Genesis video"
            width="600"
            height="1200"
            class="block w-full h-auto rounded-[28px]"
            loading="eager"
            decoding="async"
            referrerpolicy="no-referrer"
            onerror="this.onerror=null; this.src='/assets/bible-bedtime-logo-20260520.webp'; this.alt='Bible Bedtime moon and book logo';"
          />
        </div>
      </div>
    </section>
    <section class="bg-night-deep text-cream">
      <div class="max-w-page mx-auto px-6 md:px-10 py-14 md:py-20">
        <h2 class="text-cream text-4xl md:text-5xl font-medium">Begin with what’s free.</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          <div class="border-t border-gold/60 pt-5"><h3 class="text-cream text-2xl">Three complete stories</h3><p class="mt-3 text-cream/80">Listen to Genesis — Creation and Eden, Joseph — The Coat and the Promise, and Jesus Calms the Storm.</p></div>
          <div class="border-t border-gold/60 pt-5"><h3 class="text-cream text-2xl">Tonight’s Scripture</h3><p class="mt-3 text-cream/80">Read the complete passage and its Daily Teaching without a subscription.</p></div>
          <div class="border-t border-gold/60 pt-5"><h3 class="text-cream text-2xl">A pace that suits you</h3><p class="mt-3 text-cream/80">Save favourites and return to an unfinished story.</p></div>
        </div>
      </div>
    </section>
    <section class="bg-night">
      <div class="max-w-page mx-auto px-6 md:px-10 py-14 md:py-20 text-center">
        <h2 class="text-4xl md:text-5xl font-medium">Ready for tonight?</h2>
        <p class="mt-4 mx-auto max-w-[620px] text-lg text-cream/80">Download Bible Bedtimes on iPhone or iPad. Apple shows any eligible Premium offer and renewal terms before you subscribe.</p>
        <a class="btn-gold mt-8 rounded-lg px-7 py-4 text-lg" href={appStoreBottom}>Get Bible Bedtimes on the App Store</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
