---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Verse from '../../components/Verse.astro';
import { appStoreLink } from '../../lib/appstore';
import { ORGANIZATION_ID, SITE, abs } from '../../lib/site';
import {
  type Story,
  stories,
  storyHref,
  passageKey,
  campaignFor,
  productPageFor,
  isFree,
  isLong,
  sectionOf,
  sections,
  lengthLabel,
  isoDuration,
  themes,
  partsOf,
  relatedTo,
} from '../../lib/stories';

export function getStaticPaths() {
  return stories.map((story) => ({ params: { id: story.id }, props: { story } }));
}

interface Props { story: Story }
const { story } = Astro.props;

const url = abs(storyHref(story));
const free = isFree(story);
const length = lengthLabel(story);
const section = sections.find((s) => s.id === sectionOf(story))!;
const passage = passageKey(story);
const storyThemes = themes(story);
const parts = partsOf(story);
const related = relatedTo(story);
const listen = appStoreLink(campaignFor(story), productPageFor(story));

const title = `${story.title} — Bible Sleep Story | Bible Bedtime`;
const fullDescription = `${story.description} A ${length} ${free ? 'free ' : ''}audio story from ${story.reference} in the Bible Bedtimes app.`;
const description = [...fullDescription].length <= 160 ? fullDescription : story.description;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AudioObject',
    name: story.title,
    description: story.description,
    url,
    duration: isoDuration(story),
    inLanguage: 'en-GB',
    genre: 'Bible story',
    isAccessibleForFree: free,
    isBasedOn: `${story.reference} (King James Version)`,
    keywords: storyThemes.join(', ') || undefined,
    image: abs('/assets/og-app-20260918.jpg'),
    publisher: { '@type': 'Organization', '@id': ORGANIZATION_ID, name: SITE.name, url: SITE.url },
    potentialAction: { '@type': 'ListenAction', target: SITE.appStore },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Stories', item: abs('/stories/') },
      { '@type': 'ListItem', position: 3, name: story.title, item: url },
    ],
  },
];
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </Fragment>
  <Header />
  <main>
    <section class="relative isolate overflow-hidden border-b border-white/[0.08]">
      <img src="/assets/app/hero-shepherd-dusk-900.webp" alt="" width="720" height="405" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-30" />
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-b from-night/70 via-night/85 to-night"></div>
      <div class="max-w-3xl mx-auto px-6 md:px-10 pt-10 pb-14 md:pt-14 md:pb-16">
        <nav aria-label="Breadcrumb" class="text-sm text-cream/60">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <a href="/stories/" class="hover:text-gold-light">Stories</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span aria-current="page">{story.title}</span>
        </nav>
        <p class="eyebrow mt-8">{section.label} · {story.reference}</p>
        <h1 class="mt-4 font-medium leading-[1.05] text-[40px] sm:text-[54px]">{story.title}</h1>
        <p class="mt-6 text-lg md:text-xl leading-relaxed text-cream/80">{story.description}</p>

        <dl class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
          <div class="panel px-4 py-3">
            <dt class="text-cream/60">Bible passage</dt>
            <dd class="mt-1 font-semibold text-cream">{story.reference}</dd>
          </div>
          <div class="panel px-4 py-3">
            <dt class="text-cream/60">Length</dt>
            <dd class="mt-1 font-semibold text-cream">{length}</dd>
          </div>
          <div class="panel px-4 py-3 col-span-2 sm:col-span-1">
            <dt class="text-cream/60">In the app</dt>
            <dd class="mt-1 font-semibold text-cream">{free ? 'Free' : 'Premium'}</dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={listen} class="btn-gold rounded-full px-6 py-3.5">Listen in the app</a>
          <a href="/stories/" class="btn-outline rounded-full px-6 py-3.5">All stories</a>
        </div>
        <p class="mt-4 text-sm text-cream/65">
          {free
            ? 'One of three complete stories that are free in Bible Bedtimes for iPhone and iPad, with a sleep timer.'
            : 'Part of Bible Bedtimes Premium for iPhone and iPad. The app is free to download, and you can play a two-minute sample of this story first.'}
        </p>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-6 md:px-10 py-14 md:py-16">
      {passage && (
        <section aria-labelledby="passage-heading">
          <h2 id="passage-heading" class="font-serif font-medium text-3xl sm:text-4xl text-cream">From the passage</h2>
          <p class="mt-3 text-cream/75 leading-relaxed">
            {isLong(story)
              ? `A few lines from one of the passages behind this hour-long listen, in the King James Version.`
              : `A few lines from ${story.reference}, in the King James Version. The story retells the whole account.`}
          </p>
          <div class="mt-6"><Verse ref={passage} numbers /></div>
        </section>
      )}

      {parts.length > 0 && (
        <section aria-labelledby="parts-heading" class="mt-14">
          <h2 id="parts-heading" class="font-serif font-medium text-3xl sm:text-4xl text-cream">What this listen draws on</h2>
          <p class="mt-3 text-cream/75 leading-relaxed">This hour-long listen weaves together passages that also have their own single stories in the app:</p>
          <ul class="mt-5 grid gap-3">
            {parts.map((p) => (
              <li><a href={storyHref(p)} class="panel block px-5 py-4 hover:border-gold/40 transition-colors"><span class="font-serif text-xl text-cream">{p.title}</span> <span class="text-sm text-cream/60">· {p.reference}</span></a></li>
            ))}
          </ul>
        </section>
      )}

      {storyThemes.length > 0 && (
        <p class="mt-10 text-sm text-cream/65"><span class="font-semibold text-cream/80">Themes:</span> {storyThemes.join(', ')}</p>
      )}

      <section aria-labelledby="related-heading" class="mt-14">
        <h2 id="related-heading" class="font-serif font-medium text-3xl sm:text-4xl text-cream">If you like this story</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {related.map((r) => (
            <li>
              <a href={storyHref(r)} class="panel block h-full p-5 hover:border-gold/40 transition-colors">
                <span class="block text-xs uppercase tracking-wider text-gold-light">{r.reference} · {lengthLabel(r)}</span>
                <span class="mt-2 block font-serif text-xl text-cream">{r.title}</span>
                <span class="mt-1 block text-sm text-cream/65">{isFree(r) ? 'Free' : 'Premium'}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-cream/75">More for the evening: <a class="text-gold-light underline underline-offset-4" href="/bible-sleep-stories/">Bible sleep stories</a>, <a class="text-gold-light underline underline-offset-4" href="/psalms-for-sleep/">psalms for sleep</a> and <a class="text-gold-light underline underline-offset-4" href="/bible-verses-for-sleep/">Bible verses for sleep</a>.</p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
