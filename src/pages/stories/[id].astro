---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Verse from '../../components/Verse.astro';
import SamplePlayer from '../../components/SamplePlayer.astro';
import { sampleFor } from '../../lib/samples';
import { appStoreLink } from '../../lib/appstore';
import { ORGANIZATION_ID, SITE, abs } from '../../lib/site';
import {
  type Story,
  stories,
  storyHref,
  passageKey,
  campaignFor,
  productPageFor,
  isFree,
  isLong,
  sectionOf,
  sections,
  lengthLabel,
  isoDuration,
  themes,
  partsOf,
  relatedTo,
  storyArt,
} from '../../lib/stories';

export function getStaticPaths() {
  return stories.map((story) => ({ params: { id: story.id }, props: { story } }));
}

interface Props { story: Story }
const { story } = Astro.props;

const url = abs(storyHref(story));
const free = isFree(story);
const length = lengthLabel(story);
const section = sections.find((s) => s.id === sectionOf(story))!;
const passage = passageKey(story);
const storyThemes = themes(story);
const parts = partsOf(story);
const related = relatedTo(story);
const listen = appStoreLink(campaignFor(story), productPageFor(story));
const sample = sampleFor(story.id);

const title = `${story.title} — Bible Sleep Story | Bible Bedtimes`;
const fullDescription = `${story.description} A ${length} ${free ? 'free ' : ''}audio story from ${story.reference} in the Bible Bedtimes app.`;
const description = [...fullDescription].length <= 160 ? fullDescription : story.description;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AudioObject',
    name: story.title,
    description: story.description,
    url,
    duration: isoDuration(story),
    inLanguage: 'en-GB',
    genre: 'Bible story',
    isAccessibleForFree: free,
    isBasedOn: `${story.reference} (King James Version)`,
    keywords: storyThemes.join(', ') || undefined,
    image: abs('/assets/og-app-20260918.jpg'),
    publisher: { '@type': 'Organization', '@id': ORGANIZATION_ID, name: SITE.name, url: SITE.url },
    potentialAction: { '@type': 'ListenAction', target: SITE.appStore },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Stories', item: abs('/stories/') },
      { '@type': 'ListItem', position: 3, name: story.title, item: url },
    ],
  },
];
---
<BaseLayout title={title} description={description} appArgument={url}>
  <Fragment slot="head">
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </Fragment>
  <Header />
  <main>
    <section class="band">
      <img src={storyArt(story.id, 'blur')} alt="" width="64" height="36" class="band-art band-art-blur" />
      <div aria-hidden="true" class="band-wash"></div>
      <div class="wrap story-hero pt-[30px] pb-10 sm:pt-14 sm:pb-14">
        <div class="story-t">
          <nav aria-label="Breadcrumb" class="crumbs">
            <a href="/">Home</a>
            <span aria-hidden="true" class="mx-2.5">/</span>
            <a href="/stories/">Stories</a>
            <span aria-hidden="true" class="mx-2.5">/</span>
            <span aria-current="page">{story.title}</span>
          </nav>
          <p class="eyebrow mt-4 sm:mt-6">{section.label} · {story.reference}</p>
          <h1 class="h1-page mt-4">{story.title}</h1>
          <p class="lead mt-4 sm:mt-[22px]">{story.description}</p>

          <dl class="mt-[22px] sm:mt-7 grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
            <div class="panel px-[18px] py-3.5">
              <dt class="small text-cream/70">Bible passage</dt>
              <dd class="mt-1 font-semibold text-cream">{story.reference}</dd>
            </div>
            <div class="panel px-[18px] py-3.5">
              <dt class="small text-cream/70">Length</dt>
              <dd class="mt-1 font-semibold text-cream">{length}</dd>
            </div>
            <div class="panel px-[18px] py-3.5 col-span-2 sm:col-span-1">
              <dt class="small text-cream/70">In the app</dt>
              <dd class="mt-1 font-semibold text-cream">{free ? 'Free' : 'Premium'}</dd>
            </div>
          </dl>
        </div>

        <div class="story-b mt-[26px] sm:mt-7 flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:gap-[14px]">
          <a href={listen} class="btn-gold">Listen in the app</a>
          <a href="/stories/" class="btn-outline">All stories</a>
        </div>

        {sample && <div class="story-s"><SamplePlayer sample={sample} title={story.title} /></div>}

        <img
          src={storyArt(story.id, 1040)}
          srcset={`${storyArt(story.id, 480)} 480w, ${storyArt(story.id, 1040)} 1040w`}
          sizes="(min-width: 1024px) 520px, 100vw"
          alt={`Painting for ${story.title}`}
          width="1040"
          height="585"
          fetchpriority="high"
          class="story-art mt-6 lg:mt-0 aspect-video w-full rounded-[22px] border border-cream/[0.12] object-cover shadow-xl shadow-black/40"
        />

        <div class="story-p">
          <p class="mt-4 small text-cream/[0.82]">
            {free
              ? 'One of three complete stories that are free in Bible Bedtimes for iPhone and iPad, with a sleep timer.'
              : 'Free to download. You can play a 2-minute sample of this story first.'}
          </p>
          <p class="story-find mt-2 pt-3 border-t border-cream/[0.12] small text-cream/[0.82]">After you install: open Stories and choose {story.title}.</p>
        </div>
      </div>
    </section>

    <div class="wrap py-10 sm:py-16">
      <div class="measure">
      {passage && (
        <section aria-labelledby="passage-heading">
          <h2 id="passage-heading" class="h2-page">From the passage</h2>
          <p class="mt-3.5 text-cream/[0.82]">
            {isLong(story)
              ? `A few lines from one of the passages behind this hour-long listen, in the King James Version.`
              : `A few lines from ${story.reference}, in the King James Version. The story retells the whole account.`}
          </p>
          <div class="mt-6"><Verse ref={passage} numbers /></div>
        </section>
      )}

      {parts.length > 0 && (
        <section aria-labelledby="parts-heading" class="mt-14">
          <h2 id="parts-heading" class="h2-page">What this listen draws on</h2>
          <p class="mt-3.5 text-cream/[0.82]">This hour-long listen weaves together passages that also have their own single stories in the app:</p>
          <ul class="mt-5 grid gap-3">
            {parts.map((p) => (
              <li><a href={storyHref(p)} class="panel flex items-center gap-4 p-3 pr-5 hover:border-gold/50 transition-colors"><img src={storyArt(p.id, 480)} alt="" width="480" height="270" loading="lazy" decoding="async" class="w-[104px] shrink-0 aspect-video rounded-[14px] object-cover" /><span><span class="h3-page !text-[21px]">{p.title}</span> <span class="small text-cream/70">· {p.reference}</span></span></a></li>
            ))}
          </ul>
        </section>
      )}

      {storyThemes.length > 0 && (
        <p class="mt-7 small text-cream/[0.82]"><span class="font-semibold text-cream">Themes:</span> {storyThemes.join(', ')}</p>
      )}

      <section aria-labelledby="related-heading" class="mt-14">
        <h2 id="related-heading" class="h2-page">If you like this story</h2>
        <ul class="mt-[26px] grid gap-4 sm:gap-5 sm:grid-cols-3">
          {related.map((r) => (
            <li>
              <a href={storyHref(r)} class="panel flex h-full flex-col gap-1.5 overflow-hidden pb-[18px] hover:border-gold/50 transition-colors">
                <img src={storyArt(r.id, 480)} alt="" width="480" height="270" loading="lazy" decoding="async" class="mb-2 aspect-video w-full object-cover" />
                <span class="block px-[18px] text-[13px] font-semibold tracking-[0.06em] text-gold-light">{r.reference} · {lengthLabel(r)}</span>
                <span class="block px-[18px] h3-page">{r.title}</span>
                <span class="block px-[18px] small text-cream/[0.82]">{isFree(r) ? 'Free' : 'Premium'}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-7 text-cream/[0.82]">More for the evening: <a class="inline" href="/bible-sleep-stories/">Bible sleep stories</a>, <a class="inline" href="/psalms-for-sleep/">psalms for sleep</a> and <a class="inline" href="/bible-verses-for-sleep/">Bible verses for sleep</a>.</p>
      </section>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  @media (min-width: 1024px) {
    .story-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 520px;
      grid-template-areas: 't a' 'b a' 's a' 'p a';
      column-gap: 56px;
      align-items: start;
    }
    .story-t { grid-area: t; }
    .story-b { grid-area: b; }
    .story-s { grid-area: s; }
    .story-p { grid-area: p; }
    .story-art { grid-area: a; align-self: center; }
  }
</style>
