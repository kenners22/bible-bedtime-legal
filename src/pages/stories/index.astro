---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AppCta from '../../components/AppCta.astro';
import catalog from '../../data/catalog-snapshot.json';
import { abs } from '../../lib/site';
import { stories, storyHref, sections, sectionOf, isFree, lengthLabel } from '../../lib/stories';

const total = stories.length;
const free = stories.filter(isFree);
const groups = sections.map((s) => ({ ...s, stories: stories.filter((st) => sectionOf(st) === s.id) })).filter((g) => g.stories.length);
const snapshot = new Date(catalog.snapshot).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const title = `All ${total} Bible Bedtime Stories — Old Testament, Gospels and Psalms`;
const description = `Every Bible story in the Bible Bedtimes app, with its passage, length and whether it is free. From Creation to the road to Emmaus, plus hour-long listens.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Bible Bedtime stories',
    description,
    url: abs('/stories/'),
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: total,
      itemListElement: stories.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, url: abs(storyHref(s)) })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Stories', item: abs('/stories/') },
    ],
  },
];
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </Fragment>
  <Header />
  <main>
    <section class="relative isolate overflow-hidden border-b border-white/[0.08]">
      <img src="/assets/app/hero-shepherd-dusk-900.webp" alt="" width="720" height="405" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-30" />
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-b from-night/70 via-night/85 to-night"></div>
      <div class="max-w-3xl mx-auto px-6 md:px-10 pt-10 pb-14 md:pt-14 md:pb-16">
        <nav aria-label="Breadcrumb" class="text-sm text-cream/60">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span aria-current="page">Stories</span>
        </nav>
        <p class="eyebrow mt-8">The story library</p>
        <h1 class="mt-4 font-medium leading-[1.05] text-[40px] sm:text-[54px]">Every Bible Bedtime story</h1>
        <p class="mt-6 text-lg md:text-xl leading-relaxed text-cream/80">
          There are {total} stories in Bible Bedtimes, each a calm retelling of a passage you can look up for yourself. {free.length} are complete and free: {free.map((s, i) => <>{i > 0 && (i === free.length - 1 ? ' and ' : ', ')}<a class="text-gold-light underline underline-offset-4" href={storyHref(s)}>{s.title}</a></>)}.
        </p>
        <nav aria-label="Story sections" class="mt-8 flex flex-wrap gap-3 text-sm">
          {groups.map((g) => <a href={`#${g.id}`} class="btn-outline rounded-full px-4 py-2">{g.title}</a>)}
        </nav>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-6 md:px-10 py-14 md:py-16">
      {groups.map((g) => (
        <section id={g.id} aria-labelledby={`${g.id}-heading`} class="scroll-mt-24 mb-14">
          <h2 id={`${g.id}-heading`} class="font-serif font-medium text-3xl sm:text-4xl text-cream">{g.title}</h2>
          <p class="mt-3 text-cream/75 leading-relaxed">{g.note}</p>
          <ul class="mt-6 divide-y divide-white/[0.08] border-y border-white/[0.08]">
            {g.stories.map((s) => (
              <li class="py-5">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="font-serif text-[22px] text-cream"><a href={storyHref(s)} class="hover:text-gold-light">{s.title}</a></h3>
                  <span class="text-sm text-cream/60">{s.reference} · {lengthLabel(s)} · {isFree(s) ? 'Free' : 'Premium'}</span>
                </div>
                <p class="mt-2 text-cream/70 leading-relaxed">{s.description}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="text-sm text-cream/60">Premium stories include a two-minute sample you can play first. This list reflects the app catalogue on {snapshot}.</p>

      <AppCta campaign="site_stories_index" />

      <p class="text-cream/75">New to listening at night? Read our guide to <a class="text-gold-light underline underline-offset-4" href="/bible-sleep-stories/">Bible sleep stories</a>.</p>
    </div>
  </main>
  <Footer />
</BaseLayout>
