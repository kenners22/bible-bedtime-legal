---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AppCta from '../../components/AppCta.astro';
import catalog from '../../data/catalog-snapshot.json';
import { abs } from '../../lib/site';
import { stories, storyHref, sections, sectionOf, isFree, lengthLabel, storyArt } from '../../lib/stories';

const total = stories.length;
const free = stories.filter(isFree);
const groups = sections.map((s) => ({ ...s, stories: stories.filter((st) => sectionOf(st) === s.id) })).filter((g) => g.stories.length);
const snapshot = new Date(catalog.snapshot).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const title = `All ${total} Bible Bedtimes Stories — Old Testament, Gospels and Psalms`;
const description = `Every Bible story in the Bible Bedtimes app, with its passage, length and whether it is free. From Creation to the road to Emmaus, plus hour-long listens.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Bible Bedtimes stories',
    description,
    url: abs('/stories/'),
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: total,
      itemListElement: stories.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, url: abs(storyHref(s)) })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Stories', item: abs('/stories/') },
    ],
  },
];
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </Fragment>
  <Header />
  <main>
    <section class="band">
      <img src="/assets/app/hero-shepherd-dusk-900.webp" alt="" width="720" height="405" class="band-art band-art-blur" />
      <div aria-hidden="true" class="band-wash"></div>
      <div class="wrap pt-[30px] pb-10 sm:pt-14 sm:pb-16">
        <div class="measure">
          <nav aria-label="Breadcrumb" class="crumbs">
            <a href="/">Home</a>
            <span aria-hidden="true" class="mx-2.5">/</span>
            <span aria-current="page">Stories</span>
          </nav>
          <p class="eyebrow mt-4 sm:mt-6">The story library</p>
          <h1 class="h1-page mt-4">Every Bible Bedtimes story</h1>
          <p class="lead mt-4 sm:mt-[22px]">
            There are {total} stories in Bible Bedtimes, each a calm retelling of a passage you can look up for yourself. {free.length} are complete and free: {free.map((s, i) => <>{i > 0 && (i === free.length - 1 ? ' and ' : ', ')}<a class="inline" href={storyHref(s)}>{s.title}</a></>)}.
          </p>
          <nav aria-label="Story sections" class="mt-6 sm:mt-[30px] flex flex-wrap gap-2 sm:gap-2.5">
            {groups.map((g) => <a href={`#${g.id}`} class="pill-link">{g.title}</a>)}
          </nav>
        </div>
      </div>
    </section>

    <div class="wrap py-10 sm:py-16">
      <div class="measure">
      {groups.map((g) => (
        <section id={g.id} aria-labelledby={`${g.id}-heading`} class="scroll-mt-24 mb-14">
          <h2 id={`${g.id}-heading`} class="h2-page">{g.title}</h2>
          <p class="mt-3.5 text-cream/[0.82]">{g.note}</p>
          <ul class="mt-6 divide-y divide-cream/[0.12] border-y border-cream/[0.12]">
            {g.stories.map((s) => (
              <li class="flex flex-col gap-4 py-5 sm:flex-row sm:items-start sm:gap-5">
                <a href={storyHref(s)} tabindex="-1" aria-hidden="true" class="shrink-0"><img src={storyArt(s.id, 480)} alt="" width="480" height="270" loading="lazy" decoding="async" class="aspect-video w-full sm:w-[176px] rounded-[14px] border border-cream/[0.12] object-cover" /></a>
                <div class="min-w-0">
                  <h3 class="h3-page"><a href={storyHref(s)} class="hover:text-gold-light">{s.title}</a></h3>
                  <p class="mt-1 small text-cream/70">{s.reference} · {lengthLabel(s)} · {isFree(s) ? 'Free' : 'Premium'}</p>
                  <p class="mt-2 text-cream/[0.82]">{s.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="small text-cream/70">Premium stories include a two-minute sample you can play first. This list reflects the app catalogue on {snapshot}.</p>

      <AppCta campaign="site_stories_index" />

      <p class="text-cream/[0.82]">New to listening at night? Read our guide to <a class="inline" href="/bible-sleep-stories/">Bible sleep stories</a>.</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
