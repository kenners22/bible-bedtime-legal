---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Terms of Service | Bible Bedtimes';
const description = 'Bible Bedtime Terms of Service governing use of our gentle Bible story videos, devotionals, and bedtime reflections.';
---
<BaseLayout title={title} description={description}>
  <Header />
  <main class="bg-night">
    <div class="wrap py-10 sm:py-16"><article class="measure">
      <h1 class="h1-page">Terms of Service</h1>
      <p class="small text-cream/70 mt-3">Last updated: May 15, 2026</p>

      <p class="lead mt-6">Bible Bedtime shares gentle Bible story videos and bedtime reflections through official Bible Bedtime social media channels.</p>

      <h2 class="h3-page mt-10">Use of Content</h2>
      <p class="mt-3 text-cream/[0.82]">Bible Bedtime videos, descriptions, images, and related materials are provided for personal viewing and reflection. You may not falsely represent yourself as Bible Bedtime or use Bible Bedtime content in a way that suggests sponsorship, endorsement, or ownership without permission.</p>

      <h2 class="h3-page mt-10">Official Channels</h2>
      <p class="mt-3 text-cream/[0.82]">Bible Bedtime posts through its own official social media profiles. We do not provide a public posting, publishing, or account-management service for third-party accounts.</p>

      <h2 class="h3-page mt-10">No Professional Advice</h2>
      <p class="mt-3 text-cream/[0.82]">Bible Bedtime content is devotional and reflective in nature. It is not medical, legal, financial, or professional advice.</p>

      <h2 class="h3-page mt-10">Platform Terms</h2>
      <p class="mt-3 text-cream/[0.82]">Use of Bible Bedtime content on TikTok, YouTube, Facebook, or any other platform is also subject to that platform's own terms and policies.</p>

      <h2 class="h3-page mt-10">Changes</h2>
      <p class="mt-3 text-cream/[0.82]">These terms may be updated from time to time. Continued use of Bible Bedtime content after updates means you accept the updated terms.</p>

      <h2 class="h3-page mt-10">Contact</h2>
      <p class="mt-3 text-cream/[0.82]">For questions about these terms, contact Bible Bedtime through the official TikTok profile: <a class="inline" href="https://www.tiktok.com/@biblebedtimestories22">@biblebedtimestories22</a>.</p>
    </article></div>
  </main>
  <Footer />
</BaseLayout>
