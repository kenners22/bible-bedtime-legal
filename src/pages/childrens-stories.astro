---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Personalised Bible Stories for Kids | Bible Bedtime";
const description = "Personalised Bible bedtime stories for children, daily scriptures for adults, and the Bible Bedtime app — faith-filled moments that bring peace to your day and night.";

const cards = [
  {
    title: 'Bedtime Stories For Kids',
    description: 'Personalised stories that make bedtime peaceful and meaningful.',
    cta: 'Sign Up Free',
    href: '/childrens-emails/',
    icon: 'kids',
  },
  {
    title: 'Daily Scriptures For You',
    description: 'Encouraging Bible verses sent to your inbox every day.',
    cta: 'Sign Up Free',
    href: '/daily-scriptures/',
    icon: 'mail',
  },
  {
    title: 'Bible Bedtime App',
    description: 'Audio stories, offline listening, sleep timer and more.',
    cta: 'Download App',
    href: '/app/',
    icon: 'app',
  },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative bg-cream overflow-hidden">
      <div class="max-w-page mx-auto px-6 md:px-10 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center pt-10 pb-16 lg:pt-16 lg:pb-24">
        <div class="lg:col-span-7 relative z-10">
          <h1 class="font-serif font-medium text-navy leading-[1.05] tracking-tight text-[44px] sm:text-[56px] lg:text-[64px] xl:text-[72px]">
            God's Word.<br />For Every Bedtime.
          </h1>
          <p class="mt-6 max-w-lg text-navy/75 text-lg leading-relaxed">
            Personalised Bible stories for kids. Daily scriptures for adults. Faith-filled moments that bring peace to your day and night.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/daily-scriptures/" class="btn bg-navy text-cream rounded-md px-6 py-4 text-[15px] hover:bg-navy-deep">
              Start Free
            </a>
            <a href="/bible-stories/" class="btn-outline rounded-md px-6 py-4 text-[15px]">
              Explore Stories
            </a>
          </div>

          <span aria-hidden="true" class="absolute top-2 left-1/2 text-gold/60 text-xl">✦</span>
          <span aria-hidden="true" class="absolute top-32 -left-2 text-gold/40 text-base">✦</span>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="child-blob mx-auto w-full max-w-[520px] aspect-square overflow-hidden">
            <img
              src="/assets/childrens-stories-hero-20260602.png"
              alt="A child in cosy pyjamas reading a tablet in bed with two teddy bears, set against a starry night sky with a crescent moon"
              width="1024"
              height="1024"
              class="block w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Made for Every Season of Life -->
    <section aria-labelledby="seasons-heading" class="bg-cream pb-20 pt-4">
      <div class="max-w-page mx-auto px-6 md:px-10">
        <h2 id="seasons-heading" class="font-serif font-medium text-navy text-center text-3xl sm:text-4xl mb-12">
          Made for Every Season of Life
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {cards.map((card) => (
            <li class="bg-cream-300/60 rounded-2xl p-7 flex flex-col gap-3">
              <span class="w-10 h-10 rounded-lg bg-navy text-gold inline-grid place-items-center">
                {card.icon === 'kids' && (
                  <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
                )}
                {card.icon === 'mail' && (
                  <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                )}
                {card.icon === 'app' && (
                  <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="3" /><path d="M11 18h2" /></svg>
                )}
              </span>
              <h3 class="font-serif font-semibold text-navy text-xl">{card.title}</h3>
              <p class="text-navy/70 text-[15px] leading-relaxed flex-1">{card.description}</p>
              <a href={card.href} class="text-navy font-semibold text-[15px] inline-flex items-center gap-2 hover:text-gold-deep">
                {card.cta} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Verse banner -->
    <section aria-label="Verse" class="bg-navy text-cream py-6 text-center">
      <p class="font-serif italic text-base sm:text-lg">
        <span aria-hidden="true" class="text-gold mr-2">☾</span>
        &ldquo;Your word is a lamp for my feet, a light on my path.&rdquo;
        <span class="text-gold font-semibold not-italic ml-2">— Psalm 119:105</span>
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .child-blob {
    border-radius: 60% 40% 55% 45% / 50% 60% 40% 50%;
    box-shadow: 0 30px 60px rgba(6, 20, 42, 0.35);
  }
</style>
