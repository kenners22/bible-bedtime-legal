---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import kjv from '../data/kjv.json';
import { stories, storyHref, sections, sectionOf, isFree } from '../lib/stories';
import { abs } from '../lib/site';
import { appStoreLink } from '../lib/appstore';

const total = stories.length;
const free = stories.filter(isFree);
const title = 'Bible Stories to Listen to at Bedtime | Bible Bedtimes';
const description = `${total} calm Bible stories to listen to, from Creation and Joseph to Jesus calming the storm, each with its passage and length. Three are free in the app.`;
const lamp = kjv['Psalms 119:105'];

// The app's own collections, with a few real titles from each.
const collections = sections
  .map((sec) => {
    const list = stories.filter((s) => sectionOf(s) === sec.id);
    return { id: sec.id, title: sec.title, description: sec.note, count: list.length, examples: list.slice(0, 3) };
  })
  .filter((c) => c.count);

const faqs = [
  {
    q: 'Where can I listen to Bible stories at bedtime?',
    a: `Bible Bedtimes is a free iPhone and iPad app with ${total} calm Bible stories to listen to or watch, from Genesis to the Gospels, with a sleep timer. Three complete stories are free, and the optional Premium subscription opens the full library and offline listening.`,
  },
  {
    q: 'Which Bible stories are in the app?',
    a: 'The library covers Old Testament stories such as Creation, Noah, Joseph, Ruth, David and Goliath and Daniel; New Testament stories such as the Good Samaritan, the Prodigal Son and the Road to Emmaus; Psalms 23 and 91; and hour-long listens that weave several stories together.',
  },
  {
    q: 'Do the stories stay close to the Bible?',
    a: 'Yes. Each story is a calm retelling of a named passage, such as Mark 4:35–41 for Jesus calming the storm, rather than a new plot. Every story page on this site gives the reference and a short King James reading so you can look the passage up for yourself.',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Bible stories', item: abs('/bible-stories/') },
  ],
};
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>
  <Header />
  <main>
    <section class="band">
      <img src="/assets/app/hero-shepherd-dusk-900.webp" alt="" width="720" height="405" class="band-art band-art-blur" />
      <div aria-hidden="true" class="band-wash"></div>
      <div class="wrap pt-[30px] pb-10 sm:pt-14 sm:pb-16"><div class="measure">
        <p class="eyebrow">Bible Stories</p>
        <h1 class="h1-page mt-4">
          Timeless stories,<br />retold for today
        </h1>
        <p class="lead mt-4 sm:mt-[22px]">
          From the first light of Creation to the road to Emmaus, the stories of Scripture
          carry hope across generations. Bible Bedtimes retells {total} of them calmly, to
          listen to at the end of the day, and {free.length} are free.
        </p>
        <div class="mt-[26px] sm:mt-8 flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:gap-[14px]">
          <a href={appStoreLink('site_bible_stories')} class="btn-gold">
            Download on the App Store
          </a>
          <a href="/stories/" class="btn-outline">
            Browse all {total} stories
          </a>
        </div>
      </div></div>
    </section>

    <section aria-labelledby="collections-heading" class="bg-night pt-10 sm:pt-16 pb-[52px] sm:pb-16">
      <div class="wrap">
        <h2 id="collections-heading" class="h2-page mb-8 sm:mb-10">
          Explore the collections
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {collections.map((item) => (
            <li class="panel p-7 flex flex-col gap-3">
              <h3 class="h3-page"><a href={`/stories/#${item.id}`} class="hover:text-gold-light">{item.title}</a> <span class="font-sans small font-normal text-cream/70">· {item.count}</span></h3>
              <p class="text-cream/[0.82]">{item.description}</p>
              <p class="text-cream/[0.82]">Including {item.examples.map((e, i) => <>{i > 0 && (i === item.examples.length - 1 ? ' and ' : ', ')}<a href={storyHref(e)} class="inline">{e.title}</a></>)}.</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="faq-heading" class="bg-night pb-[52px] sm:pb-[88px]">
      <div class="wrap"><div class="measure">
        <h2 id="faq-heading" class="h2-page">Questions</h2>
        <div class="mt-5 divide-y divide-cream/[0.12] border-y border-cream/[0.12]">
          {faqs.map((f) => (
            <details class="group py-2">
              <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-5 font-serif font-semibold text-[21px] sm:text-2xl leading-tight text-cream">
                {f.q}
                <span aria-hidden="true" class="text-gold-light transition-transform group-open:rotate-45 text-2xl leading-none">+</span>
              </summary>
              <p class="mt-2 mb-3 text-cream/[0.82]">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
      </div>
    </section>

    <section aria-label="Verse" class="bg-night-deep text-cream border-t border-cream/[0.12]">
      <div class="wrap py-6 text-center">
      <p class="font-serif italic text-[20px] sm:text-[22px] leading-snug">
        <span aria-hidden="true" class="text-gold-light mr-2">☾</span>
        &ldquo;{lamp.text}&rdquo;
        <span class="text-gold-light font-semibold not-italic ml-2">— {lamp.reference} (KJV)</span>
      </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
