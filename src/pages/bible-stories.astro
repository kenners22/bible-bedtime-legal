---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import kjv from '../data/kjv.json';
import { stories, storyHref, sections, sectionOf, isFree } from '../lib/stories';
import { abs } from '../lib/site';

const total = stories.length;
const free = stories.filter(isFree);
const title = 'Bible Stories to Listen to at Bedtime | Bible Bedtime';
const description = `${total} calm Bible stories to listen to, from Creation and Joseph to Jesus calming the storm, each with its passage and length. Three are free in the app.`;
const lamp = kjv['Psalms 119:105'];

// The app's own collections, with a few real titles from each.
const collections = sections
  .map((sec) => {
    const list = stories.filter((s) => sectionOf(s) === sec.id);
    return { id: sec.id, title: sec.title, description: sec.note, count: list.length, examples: list.slice(0, 3) };
  })
  .filter((c) => c.count);

const faqs = [
  {
    q: 'Where can I listen to Bible stories at bedtime?',
    a: `Bible Bedtimes is a free iPhone and iPad app with ${total} calm Bible stories to listen to or watch, from Genesis to the Gospels, with a sleep timer. Three complete stories are free, and the optional Premium subscription opens the full library and offline listening.`,
  },
  {
    q: 'Which Bible stories are in the app?',
    a: 'The library covers Old Testament stories such as Creation, Noah, Joseph, Ruth, David and Goliath and Daniel; New Testament stories such as the Good Samaritan, the Prodigal Son and the Road to Emmaus; Psalms 23 and 91; and hour-long listens that weave several stories together.',
  },
  {
    q: 'Do the stories stay close to the Bible?',
    a: 'Yes. Each story is a calm retelling of a named passage, such as Mark 4:35–41 for Jesus calming the storm, rather than a new plot. Every story page on this site gives the reference and a short King James reading so you can look the passage up for yourself.',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Bible stories', item: abs('/bible-stories/') },
  ],
};
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>
  <Header />
  <main>
    <section class="relative bg-night overflow-hidden">
      <div class="max-w-page mx-auto px-6 md:px-10 pt-10 pb-14 lg:pt-16 lg:pb-20 max-w-3xl">
        <p class="eyebrow">Bible Stories</p>
        <h1 class="mt-4 font-serif font-medium text-cream leading-[1.05] tracking-tight text-[40px] sm:text-[52px] lg:text-[60px]">
          Timeless Stories,<br />Retold for Today
        </h1>
        <p class="mt-6 text-cream/75 text-lg leading-relaxed">
          From the first light of Creation to the road to Emmaus, the stories of Scripture
          carry hope across generations. Bible Bedtimes retells {total} of them calmly, to
          listen to at the end of the day, and {free.length} are free.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/download/" class="btn-gold rounded-full px-6 py-4 text-[15px]">
            Listen in the App
          </a>
          <a href="/stories/" class="btn-outline rounded-full px-6 py-4 text-[15px]">
            Browse all {total} stories
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="collections-heading" class="bg-night pb-20">
      <div class="max-w-page mx-auto px-6 md:px-10">
        <h2 id="collections-heading" class="font-serif font-medium text-cream text-center text-3xl sm:text-4xl mb-12">
          Explore the Collections
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {collections.map((item) => (
            <li class="bg-night-raised/60 border border-white/[0.08] rounded-2xl p-7 flex flex-col gap-3">
              <h3 class="font-serif font-semibold text-cream text-xl"><a href={`/stories/#${item.id}`} class="hover:text-gold-light">{item.title}</a> <span class="font-sans text-sm font-normal text-cream/55">· {item.count}</span></h3>
              <p class="text-cream/70 text-[15px] leading-relaxed">{item.description}</p>
              <p class="text-[15px] text-cream/70">Including {item.examples.map((e, i) => <>{i > 0 && (i === item.examples.length - 1 ? ' and ' : ', ')}<a href={storyHref(e)} class="text-gold-light underline underline-offset-4">{e.title}</a></>)}.</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="faq-heading" class="bg-night pb-20">
      <div class="max-w-3xl mx-auto px-6 md:px-10">
        <h2 id="faq-heading" class="font-serif font-medium text-cream text-3xl sm:text-4xl">Questions</h2>
        <div class="mt-6 divide-y divide-white/[0.08] border-y border-white/[0.08]">
          {faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-xl text-cream">
                {f.q}
                <span aria-hidden="true" class="text-gold transition-transform group-open:rotate-45 text-2xl leading-none">+</span>
              </summary>
              <p class="mt-3 text-cream/75 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section aria-label="Verse" class="bg-night-deep text-cream py-6 text-center">
      <p class="font-serif italic text-base sm:text-lg">
        <span aria-hidden="true" class="text-gold-light mr-2">☾</span>
        &ldquo;{lamp.text}&rdquo;
        <span class="text-gold-light font-semibold not-italic ml-2">— {lamp.reference} (KJV)</span>
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
