---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Bible Stories | Bible Bedtime';
const description = 'Timeless Bible stories retold with warmth and clarity — from Genesis to the Gospels — to read, reflect on, and share with your family.';

const collections = [
  {
    title: 'Old Testament',
    description: 'Creation, Noah, Joseph, Moses, David and the prophets — the great arc of God’s promise.',
  },
  {
    title: 'New Testament',
    description: 'The birth, life, miracles and resurrection of Jesus, told gently for every age.',
  },
  {
    title: 'Parables',
    description: 'The Good Samaritan, the Prodigal Son, the Lost Sheep — short stories with lasting truth.',
  },
  {
    title: 'Psalms & Wisdom',
    description: 'Comfort and courage from the Psalms, Proverbs and the poetry of Scripture.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="relative bg-night overflow-hidden">
      <div class="max-w-page mx-auto px-6 md:px-10 pt-10 pb-14 lg:pt-16 lg:pb-20 max-w-3xl">
        <p class="eyebrow">Bible Stories</p>
        <h1 class="mt-4 font-serif font-medium text-cream leading-[1.05] tracking-tight text-[40px] sm:text-[52px] lg:text-[60px]">
          Timeless Stories,<br />Retold for Today
        </h1>
        <p class="mt-6 text-cream/75 text-lg leading-relaxed">
          From the first light of Creation to the empty tomb, the stories of Scripture
          carry hope across generations. We retell them with warmth and clarity — short
          enough for a weeknight, rich enough to return to again and again.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/download/" class="btn-gold rounded-full px-6 py-4 text-[15px]">
            Listen in the App
          </a>
          <a href="/daily-scriptures/" class="btn-outline rounded-full px-6 py-4 text-[15px]">
            See Sample Scripture
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="collections-heading" class="bg-night pb-20">
      <div class="max-w-page mx-auto px-6 md:px-10">
        <h2 id="collections-heading" class="font-serif font-medium text-cream text-center text-3xl sm:text-4xl mb-12">
          Explore the Collections
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {collections.map((item) => (
            <li class="bg-night-raised/60 border border-white/[0.08] rounded-2xl p-7 flex flex-col gap-3">
              <h3 class="font-serif font-semibold text-cream text-xl">{item.title}</h3>
              <p class="text-cream/70 text-[15px] leading-relaxed">{item.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-label="Verse" class="bg-night-deep text-cream py-6 text-center">
      <p class="font-serif italic text-base sm:text-lg">
        <span aria-hidden="true" class="text-gold-light mr-2">☾</span>
        &ldquo;Your word is a lamp for my feet, a light on my path.&rdquo;
        <span class="text-gold-light font-semibold not-italic ml-2">— Psalm 119:105</span>
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
